---
import Layout from '../../layouts/Layout.astro';
import { CLINIC_URL } from '../../data/site-nav';

const description = '피부 고민과 시술 선택, 진료 전후의 질문을 쉽게 설명합니다.';
const topics = [
	['피부 고민 알아보기', '피부 변화가 신경 쓰일 때 상황을 정리하고 진료에서 물어볼 질문을 준비합니다.'],
	['시술 선택 전 질문', '시술을 결정하기 전에 기대하는 변화와 궁금한 점을 정리합니다.'],
	['시술 전후에 궁금한 점', '진료 전후에 확인할 사항과 의료진에게 전달할 질문을 모읍니다.'],
	['자주 묻는 진료 질문', '상담과 진료를 앞두고 자주 나오는 질문을 살펴봅니다.'],
];
---

<Layout title="클리닉" description={description}>
	<section class="clinic-hub" aria-labelledby="clinic-title">
		<h1 id="clinic-title">클리닉</h1>
		<p class="intro">{description}</p>
		<a href={CLINIC_URL} target="_blank" rel="noopener noreferrer">진료 안내·예약은 의원 홈페이지 ↗</a>

		<section aria-labelledby="clinic-topics">
			<h2 id="clinic-topics">환자가 궁금해하는 질문</h2>
			<p>주제별 글을 준비하고 있습니다.</p>
			<dl>
				{topics.map(([title, summary]) => (
					<div><dt>{title}</dt><dd>{summary}</dd></div>
				))}
			</dl>
		</section>
	</section>
</Layout>

<style>
	.clinic-hub {
		max-width: 46rem;
		margin-inline: auto;
		padding: clamp(1rem, 4vw, 3rem) clamp(1rem, 4vw, 2rem);
		color: var(--site-text);
		overflow-wrap: break-word;
	}
	.clinic-hub h1 { margin: 0 0 0.75rem; }
	.clinic-hub h2 { margin: 2rem 0 0.65rem; font-size: 1.25rem; }
	.clinic-hub p, .clinic-hub dd { color: var(--site-text-secondary); }
	.clinic-hub .intro { margin: 0 0 1rem; }
	.clinic-hub a { color: var(--site-mint-text); text-decoration: underline; }
	.clinic-hub dl { margin: 1rem 0 0; border-bottom: 1px solid var(--site-border); }
	.clinic-hub dl > div { padding-block: 0.8rem; border-top: 1px solid var(--site-border); }
	.clinic-hub dt { font-weight: 700; }
	.clinic-hub dd { margin: 0.2rem 0 0; }
</style>
