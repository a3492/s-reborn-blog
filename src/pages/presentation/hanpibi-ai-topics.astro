---
import Layout from '../../layouts/Layout.astro';
const tracks = [
  {id:'dx-ax',number:'01',title:'DX·AX 전환 전략',en:'Digital & AI Transformation',question:'병원의 어떤 업무부터 바꿔야 하는가?',description:'아날로그 업무를 디지털화하고 AI가 참여할 수 있도록 업무 구조와 책임 체계를 재설계합니다.',example:'수기 인수인계 → 전자화 → AI 요약·검증 → 담당자별 업무 배정',topics:['전환 목표와 우선순위','DX 없이 AX가 가능한 조건','사람의 승인·검증·복구 체계']},
  {id:'capture',number:'02',title:'업무 데이터 수집과 자동화',en:'Data Capture & Workflow Automation',question:'매일 사라지는 현장 정보를 어떻게 자산으로 바꿀 것인가?',description:'회의·인수인계·고객 상담·시술 과정의 대화와 업무 기록을 수집하고 구조화합니다.',example:'상담 녹음 → 전사 → 정보 추출 → 기록 초안 → 의료진 확인 → CRM 저장',topics:['STT·OCR·자동 추출','실시간 기록과 품질 관리','개인정보·녹음 적법성·접근 권한']},
  {id:'second-brain',number:'03',title:'세컨드 브레인과 지식 자산화',en:'PKM · KMS · RAG',question:'원장과 병원이 경험한 것을 어떻게 잊지 않는 시스템으로 만들 것인가?',description:'논문·강연·의사결정·업무 노하우를 연결하여 장기적으로 검색하고 재사용합니다.',example:'기존 강연과 논문을 연결해 새로운 강연의 근거 자료 및 초안 작성',topics:['개인 지식 관리(PKM)','조직 지식 관리(KMS)','검색 증강 생성(RAG)과 출처 확인']},
  {id:'communication',number:'04',title:'AI 커뮤니케이션과 콘텐츠 엔지니어링',en:'AI Communication & Content Engineering',question:'같은 내용을 대상에 맞춰 더 정확하고 쉽게 전달하려면?',description:'프레젠테이션·매뉴얼·직원 교육·환자 안내 등 정보 전달 방식을 개선합니다.',example:'하나의 시술 지침 → 직원 매뉴얼·환자 안내문·신입 교육자료·발표자료',topics:['대상별 표현과 정보 구조','매뉴얼·프레젠테이션 자동 생성','검토·버전 관리·배포']},
  {id:'database',number:'05',title:'데이터베이스 운영과 데이터 인텔리전스',en:'Database · Data Engineering · BI',question:'축적된 데이터를 어떻게 경영 판단에 활용할 것인가?',description:'여러 시스템에 분산된 데이터를 정제·연결·검색·분석합니다.',example:'상담 DB + 시술 DB + 재방문 DB를 연결해 이탈 구간과 후속 관리 대상 분석',topics:['DB 구조·데이터 품질','SQL·ETL·BI','지표와 대시보드·권한 관리']},
  {id:'orchestration',number:'06',title:'AI 실전 응용과 오케스트레이션',en:'AI Literacy · Engineering · Orchestration',question:'AI 도구와 기술을 실제 문제 해결에 어떻게 조합할 것인가?',description:'프롬프트·컨텍스트·에이전트·CLI·API를 업무 목적에 맞게 결합합니다.',example:'ChatGPT·Claude·Codex·CLI·Notion·외부 API를 연결한 업무 워크플로',topics:['도구 선택과 컨텍스트 설계','에이전트·자동화 연결','실행 결과 검증과 오류 복구']}
];
---
<Layout title="한피비 실전 아카데미 AI 강연 주제 | S-Reborn Presentation" description="한피비 실전 아카데미 AI 파트 6대 강연 카테고리와 실제 병원 활용 사례">
  <div class="presentation-page">
    <nav class="crumb" aria-label="현재 위치"><a href="/">홈</a><span>›</span><a href="/lecture-materials/kim-dowi/">강연·자료</a><span>›</span><strong>S-Reborn Presentation</strong></nav>
    <header class="hero"><p class="eyebrow">S—REBORN PRESENTATION · 강연 기획</p><h1>한피비 실전 아카데미<br />AI 강연 주제 분류</h1><p class="lead">AI 활용 사례를 나열하는 대신, 병원의 전환 전략·데이터·지식·소통·운영·실행 역량을 구분한 6개 트랙입니다.</p><p class="meta">2026.11.23 · 강연 주제 기획안 · 6개 트랙</p></header>
    <section aria-labelledby="overview"><h2 id="overview">한눈에 보는 6대 트랙</h2><div class="track-grid">{tracks.map(t=><a class="track-link" href={`#${t.id}`}><span class="number">{t.number}</span><strong>{t.title}</strong><small>{t.question}</small><span class="arrow" aria-hidden="true">↗</span></a>)}</div></section>
    <section aria-labelledby="framework"><h2 id="framework">전체 구조</h2><div class="framework"><div><span>A · 전략 / WHY</span><strong>① DX·AX 전환</strong></div><div><span>B · 시스템 / WHAT</span><strong>② 데이터 수집 · ③ 지식 자산화 · ④ 커뮤니케이션 · ⑤ DB 운영</strong></div><div><span>C · 실행 역량 / HOW</span><strong>⑥ AI 응용·오케스트레이션</strong></div></div><p class="note">이 구조는 개념적 분류입니다. 실제 업무에서는 데이터베이스와 지식 저장소가 병렬로 운영되며, ⑥의 실행 역량은 모든 단계에 걸쳐 적용됩니다.</p></section>
    <section aria-labelledby="detail"><h2 id="detail">트랙별 실전 강연 방향</h2><div class="details">{tracks.map(t=><article class="track-detail" id={t.id}><div class="track-heading"><span class="number">{t.number}</span><div><h3>{t.title}</h3><p class="english">{t.en}</p></div></div><p class="question">{t.question}</p><p>{t.description}</p><div class="example"><strong>병원 실전 예시</strong><p>{t.example}</p></div><p class="subhead">강연 구성 요소</p><ul>{t.topics.map(topic=><li>{topic}</li>)}</ul><a class="back" href="#overview">↑ 6대 트랙으로 돌아가기</a></article>)}</div></section>
    <section aria-labelledby="difference"><h2 id="difference">혼동하기 쉬운 ②·③·⑤의 차이</h2><div class="table-scroll"><table><thead><tr><th>구분</th><th>② 데이터 수집</th><th>③ 세컨드 브레인</th><th>⑤ DB 운영</th></tr></thead><tbody><tr><th>중심 질문</th><td>어떻게 확보하는가</td><td>어떻게 기억·재사용하는가</td><td>어떻게 구조화·분석하는가</td></tr><tr><th>주요 자료</th><td>대화·현장 기록</td><td>문서·경험·지식</td><td>고객·시술·상담·매출</td></tr><tr><th>기술</th><td>STT·OCR·추출</td><td>PKM·KMS·RAG</td><td>SQL·ETL·BI</td></tr><tr><th>결과</th><td>구조화된 기록</td><td>검색 가능한 지식 체계</td><td>분석 결과·대시보드</td></tr></tbody></table></div></section>
    <section aria-labelledby="titles"><h2 id="titles">강연 제목 후보</h2><ol class="lecture-titles"><li>AI를 도입하는 병원과 AI로 운영되는 병원의 차이</li><li>병원의 모든 대화와 업무가 데이터가 된다</li><li>원장님의 경험을 기억하는 두 번째 두뇌 만들기</li><li>매뉴얼부터 강연까지, AI로 바꾸는 정보 전달 방식</li><li>쌓여 있는 병원 데이터, 어떻게 경영에 활용할까?</li><li>프롬프트를 넘어, AI 도구를 연결해 업무를 완성하는 방법</li></ol></section>
    <section aria-labelledby="method"><h2 id="method">실전 아카데미 공통 발표 방식</h2><p>각 강연은 <strong>기존 방식 → AI 적용 방식 → 구현 결과 → 검증 및 한계</strong> 순서로 구성합니다. 환자 데이터는 실제 사례 대신 합성·비식별 자료를 우선 사용하며, 상담 녹음·의료 정보 처리에는 적법성·동의·접근 통제·의료진 검증을 적용합니다.</p></section>
  </div>
</Layout>
<style>
.presentation-page{max-width:1080px;margin:auto;padding:clamp(1rem,3vw,2.5rem);color:var(--site-text)}.crumb{display:flex;gap:.6rem;flex-wrap:wrap;font-size:.85rem;color:var(--site-text-secondary);margin:1rem 0 2rem}.crumb a,.back{color:var(--site-mint-text)}.hero{padding:clamp(1.4rem,4vw,3rem);background:var(--site-surface);border:1px solid var(--site-border);border-radius:1.25rem}.eyebrow,.meta,.english{color:var(--site-text-secondary);font-size:.85rem}.eyebrow{letter-spacing:.08em;font-weight:700}.hero h1{font-size:clamp(2rem,5vw,3.5rem);line-height:1.25;margin:.8rem 0}.lead{font-size:1.08rem;max-width:720px;line-height:1.8}.presentation-page section{margin:3.5rem 0}.presentation-page h2{font-size:1.55rem;margin:0 0 1.25rem}.track-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.85rem}.track-link,.track-detail,.framework>div{background:var(--site-surface);border:1px solid var(--site-border);border-radius:1rem;padding:1.35rem}.track-link{display:flex;flex-direction:column;gap:.55rem;color:var(--site-text);text-decoration:none;position:relative}.track-link:hover,.track-link:focus-visible{outline:2px solid var(--site-mint);outline-offset:2px}.track-link small{color:var(--site-text-secondary);line-height:1.5}.number{color:var(--site-mint-text);font-weight:800;letter-spacing:.06em}.arrow{position:absolute;right:1.1rem;top:1rem;color:var(--site-text-secondary)}.framework{display:grid;gap:.65rem}.framework>div{display:flex;flex-direction:column;gap:.5rem}.framework span,.note{color:var(--site-text-secondary);font-size:.9rem}.details{display:grid;gap:1rem}.track-detail{scroll-margin-top:6rem}.track-heading{display:flex;gap:1rem;align-items:flex-start}.track-heading h3{margin:0;font-size:1.3rem}.english{margin:.3rem 0}.question{font-weight:700;font-size:1.05rem}.track-detail p{line-height:1.75}.example{background:var(--site-subtle);border-radius:.7rem;padding:1rem;margin:1rem 0}.example p{margin:.4rem 0 0}.subhead{font-weight:700}.track-detail li{margin:.4rem 0}.back{display:inline-block;margin-top:1rem;font-size:.9rem}.table-scroll{overflow-x:auto;border:1px solid var(--site-border);border-radius:.8rem}.table-scroll table{width:100%;border-collapse:collapse;min-width:620px}.table-scroll th,.table-scroll td{padding:.85rem;text-align:left;border-bottom:1px solid var(--site-border);vertical-align:top}.table-scroll th{background:var(--site-subtle)}.lecture-titles{padding-left:1.6rem}.lecture-titles li{padding:.5rem 0;line-height:1.6}@media(max-width:600px){.track-grid{grid-template-columns:1fr}.presentation-page section{margin:2.5rem 0}}
</style>