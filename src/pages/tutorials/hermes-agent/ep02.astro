---
import Layout from '../../../layouts/Layout.astro';

const scenes = [
  {
    "id": "ready",
    "number": "01",
    "title": "PC Hermes 응답 확인",
    "location": "PowerShell · Telegram",
    "objective": "EP02의 선행조건과 준비물을 확인합니다.",
    "why": "텔레그램은 Hermes와 AI 모델이 이미 작동한다는 전제 위에서 연결됩니다. PC에서 답변이 오지 않는다면 먼저 EP01을 끝내야 합니다.",
    "actions": [
      "PC의 PowerShell에서 Hermes를 실행하여 실제 AI 답변이 오는지 확인하세요.",
      "휴대전화에 Telegram을 설치하고 본인 계정으로 로그인하세요.",
      "PC가 켜져 있고 인터넷이 연결되어 있는지 확인하세요."
    ],
    "commands": [
      {
        "label": "PC에서 실행",
        "text": "hermes"
      }
    ],
    "expected": "PC에서 Hermes가 실제로 답변하고, 텔레그램 앱을 이용할 수 있습니다.",
    "caution": "PC가 꺼지거나 절전 상태면 Gateway가 메시지를 처리하지 못할 수 있습니다.",
    "troubleshoot": [
      [
        "PC에서도 AI가 답변하지 않습니다",
        "EP01 모델 연결과 첫 응답 단계로 돌아가세요."
      ],
      [
        "텔레그램에 로그인하지 못합니다",
        "계정 로그인을 완료한 후 진행하거나 강연자 시연을 관찰하세요."
      ]
    ]
  },
  {
    "id": "bot",
    "number": "02",
    "title": "BotFather에서 내 봇 만들기",
    "location": "휴대전화 · Telegram",
    "objective": "자신의 텔레그램 봇을 만들고 발급된 토큰을 비공개로 보관합니다.",
    "why": "BotFather가 생성하는 봇은 텔레그램 메시지를 받는 별도 계정입니다. 발급 토큰은 이 봇을 제어할 수 있는 인증 정보이므로 공개해서는 안 됩니다.",
    "actions": [
      "Telegram 검색에서 공식 @BotFather를 찾아 대화를 엽니다.",
      "아래 명령을 BotFather 채팅창에 입력합니다.",
      "봇의 표시 이름을 입력하고, username은 영문 등으로 만들고 bot으로 끝나게 합니다.",
      "발급된 토큰은 본인에게만 보이도록 관리하고 강의 화면에 노출하지 않습니다."
    ],
    "commands": [
      {
        "label": "Telegram BotFather 채팅에 입력",
        "text": "/newbot"
      }
    ],
    "expected": "새로운 봇의 username이 만들어지고 BotFather에서 토큰이 개인에게 발급됩니다.",
    "caution": "봇 토큰을 웹페이지·AI 채팅·공개 강의 채팅방에 붙여넣지 마세요.",
    "troubleshoot": [
      [
        "username이 이미 사용 중입니다",
        "다른 고유한 username으로 바꿔 다시 입력하세요."
      ],
      [
        "봇이 검색되지 않습니다",
        "BotFather가 알려준 실제 username을 다시 확인하세요."
      ]
    ]
  },
  {
    "id": "userid",
    "number": "03",
    "title": "내 텔레그램 숫자 ID 확인",
    "location": "휴대전화 · Telegram",
    "objective": "허용된 사용자만 자신의 봇에 접근하도록 숫자 ID를 확인합니다.",
    "why": "Telegram username과 사용자 숫자 ID는 서로 다릅니다. Hermes 설정에서 접근을 제한하기 위해 숫자 ID를 사용합니다.",
    "actions": [
      "Telegram에서 @userinfobot을 검색합니다.",
      "제3자 봇에 본인 계정 정보가 일부 전달될 수 있음을 이해한 뒤 사용할지 결정합니다.",
      "Start를 누르고 표시되는 Id의 숫자를 본인만 보관하세요."
    ],
    "expected": "숫자 ID를 확인합니다. 개인 1:1 채팅의 사용자 ID와 그룹 채팅 ID는 다를 수 있습니다.",
    "caution": "@userinfobot은 제3자 서비스입니다. 개인정보 제공이 부담스럽다면 공식 도구와 대체 방식을 강연 이후 별도로 검토하세요.",
    "troubleshoot": [
      [
        "ID 대신 username만 보입니다",
        "숫자로 표시되는 Id 항목을 확인하세요."
      ],
      [
        "제3자 봇 사용을 원하지 않습니다",
        "이 단계는 관찰 모드로 진행하고 대체 확인 방법을 별도로 검토하세요."
      ]
    ]
  },
  {
    "id": "env",
    "number": "04",
    "title": "PC에 텔레그램 연결 정보 설정",
    "location": "PowerShell → 메모장",
    "objective": "봇 토큰과 허용 사용자 ID를 Hermes의 .env 파일에 설정합니다.",
    "why": "Gateway가 어떤 봇을 연결하고 누구의 메시지만 처리할지 알아야 하기 때문입니다. 설정 파일은 내 PC에서만 열고 보관하세요.",
    "actions": [
      "Windows PowerShell에서 기본 프로필의 .env 파일을 엽니다.",
      "같은 항목이 있다면 새 줄을 중복 추가하지 말고 기존 값을 수정하세요.",
      "예시에 표시된 값을 자신의 비공개 토큰과 숫자 ID로 바꾸어 저장하세요.",
      "파일명이 .env.txt가 아니라 .env인지 확인하고, 설정 파일은 누구에게도 보여주지 마세요."
    ],
    "commands": [
      {
        "label": "PowerShell에서 설정 파일 열기",
        "text": "notepad \"$env:LOCALAPPDATA\\hermes\\.env\""
      },
      {
        "label": "구조 예시 — 값은 가상 자리표시자입니다",
        "text": "TELEGRAM_BOT_TOKEN=YOUR_PRIVATE_BOT_TOKEN\nTELEGRAM_ALLOWED_USERS=YOUR_NUMERIC_USER_ID\nTELEGRAM_HOME_CHANNEL=YOUR_NUMERIC_USER_ID"
      }
    ],
    "expected": "본인의 설치 프로필에 올바른 이름의 .env 파일이 저장됩니다. 실제 토큰은 공개 화면에서 보이지 않아야 합니다.",
    "caution": "위 예시를 그대로 실행하는 것이 아닙니다. YOUR_...는 각자의 실제 값을 넣는 자리표시자입니다. 다른 설정을 삭제하지 마세요.",
    "troubleshoot": [
      [
        ".env 파일을 찾지 못합니다",
        "기본 설치 경로가 아니라 별도 프로필이나 HERMES_HOME을 쓰는지 확인하세요."
      ],
      [
        "파일이 .env.txt로 저장됩니다",
        "메모장에서 파일 형식과 이름을 확인한 후 .env로 저장하세요."
      ]
    ]
  },
  {
    "id": "gateway",
    "number": "05",
    "title": "Gateway 실행과 상태 확인",
    "location": "PowerShell",
    "objective": "텔레그램 메시지를 Hermes로 전달하는 Gateway를 실행합니다.",
    "why": "Gateway는 Telegram과 Hermes 사이에서 메시지를 주고받는 연결 프로세스입니다. 실행 중인 창을 닫으면 연결이 끊길 수 있습니다.",
    "actions": [
      "PowerShell에서 Gateway 실행 명령을 입력합니다.",
      "이 창은 닫지 말고 유지하세요.",
      "이미 실행 중이거나 .env를 바꾸었다면 별도의 PowerShell 창에서 상태를 확인하거나 재시작하세요."
    ],
    "commands": [
      {
        "label": "Gateway 실행",
        "text": "hermes gateway run"
      },
      {
        "label": "별도 PowerShell에서 상태 확인",
        "text": "hermes gateway status"
      },
      {
        "label": "설정 변경 후 필요한 경우 재시작",
        "text": "hermes gateway restart"
      }
    ],
    "expected": "Gateway가 실행 중이지만, 실제 텔레그램 답장 성공은 다음 단계에서 별도로 확인해야 합니다.",
    "caution": "동일 프로필에서 Gateway를 중복 실행하지 마세요. 설정 변경 전부터 실행 중이었다면 재시작이 필요할 수 있습니다.",
    "troubleshoot": [
      [
        "Gateway가 이미 실행 중이라고 나옵니다",
        "새로 실행하지 말고 상태를 확인하세요."
      ],
      [
        "실행하다가 오류가 발생합니다",
        "오류 화면의 민감정보를 가린 뒤 원인을 확인하세요."
      ]
    ]
  },
  {
    "id": "reply",
    "number": "06",
    "title": "Telegram에서 실제 답장 받기",
    "location": "휴대전화 · Telegram",
    "objective": "자신의 봇과 Hermes 사이의 메시지 왕복을 확인합니다.",
    "why": "Gateway가 running이라고 표시되는 것과 실제 AI 답장이 도착하는 것은 다릅니다. 답장을 받아야 연결 성공입니다.",
    "actions": [
      "Telegram에서 자신이 만든 봇 username을 검색하고 채팅을 엽니다.",
      "Start를 누르거나 시작 버튼을 선택합니다.",
      "안녕을 보내고 실제 AI 답변이 도착하는지 확인하세요."
    ],
    "commands": [
      {
        "label": "내 Telegram 봇 채팅에 전송",
        "text": "안녕"
      }
    ],
    "expected": "텔레그램 채팅방에 Hermes 기반 AI의 실제 답변이 도착합니다.",
    "caution": "아무 응답 없이 전송만 되었다면 아직 성공이 아닙니다. /sethome은 기본 연결 성공 후 선택 항목입니다.",
    "troubleshoot": [
      [
        "아무 답장도 오지 않습니다",
        "Start를 눌렀는지, 내 봇이 맞는지, Gateway가 실행 중인지부터 점검하세요."
      ],
      [
        "PC Hermes 자체도 답변하지 않습니다",
        "EP01 모델 연결과 실제 응답 단계로 돌아가세요."
      ]
    ]
  },
  {
    "id": "finish",
    "number": "07",
    "title": "오류 점검과 사후 이어 하기",
    "location": "PC · Telegram",
    "objective": "어느 단계까지 성공했는지 확인하고 미완료 부분을 복구합니다.",
    "why": "텔레그램 연결은 봇·계정 ID·Gateway·모델이 연속으로 연결되는 구조입니다. 실패 위치를 순서대로 좁히는 것이 효율적입니다.",
    "actions": [
      "내 봇과 Start, Gateway 상태, .env 토큰과 숫자 ID, Hermes 모델 응답을 순서대로 확인하세요.",
      "필요하면 비밀정보를 가린 후에만 로그를 점검하세요.",
      "토큰이 노출되었다면 BotFather에서 토큰을 폐기·재발급한 다음 설정과 Gateway를 갱신하세요."
    ],
    "commands": [
      {
        "label": "Gateway 상태 확인",
        "text": "hermes gateway status"
      },
      {
        "label": "민감정보 포함 가능: 본인 PC에서만 로그 점검",
        "text": "Get-Content \"$env:LOCALAPPDATA\\hermes\\logs\\gateway.log\" -Tail 50"
      }
    ],
    "expected": "실제 텔레그램 답장 성공 여부와 해결하지 못한 오류 지점이 구분됩니다.",
    "caution": "자동 실행 설치는 현장 필수 과정이 아닙니다. 로그, .env, 인증정보, 환자정보를 공유하지 마세요.",
    "troubleshoot": [
      [
        "설정 수정 후 답장이 오지 않습니다",
        "별도 PowerShell에서 hermes gateway restart 후 다시 메시지를 보내세요."
      ],
      [
        "토큰을 공개했습니다",
        "BotFather에서 노출된 토큰을 폐기하고 새 토큰으로 교체한 후 Gateway를 다시 실행하세요."
      ]
    ]
  }
];

---
<Layout title="Hermes Agent EP02 · 텔레그램 연결 실습" description="강세희 원장 Hermes Agent 강연용 텔레그램 봇과 Gateway 연결 실습" noindex={true}>
  <div class="lesson">
    <nav class="crumb" aria-label="현재 위치"><a href="/tutorials/">튜토리얼</a><span>/</span><a href="/tutorials/hermes-agent/">Hermes Agent</a><span>/</span><strong>EP02</strong></nav>
    <header class="head">
      <span class="eyebrow">HERMES AGENT · HANDS-ON · EP.02</span>
      <h1>내 휴대전화에서 <em>AI 답장 받기</em></h1>
      <p>내 개인 봇을 만들고 PC의 Hermes와 연결한 뒤 실제 메시지 응답을 확인합니다.</p>
      <div class="headlinks"><a href="/tutorials/hermes-agent/">강연 자료실</a><a href="/downloads/hermes-agent/Hermes_텔레그램_연결_통합가이드_아잉이.md" download>원본 가이드 다운로드 ↓</a></div>
    </header>

    <section class="intro">
      <h2>어디부터 시작하면 될까요?</h2>
      <div class="jump" aria-label="현재 학습 상태 선택">
        <button type="button" data-jump="ready">처음 연결해요</button>
        <button type="button" data-jump="userid">봇은 만들었어요</button>
        <button type="button" data-jump="reply">Gateway까지 실행했어요</button>
      </div>
      <p class="hint">위 선택은 입력한 상태에 따라 해당 장면으로 이동하는 기능입니다. 컴퓨터 설치 상태를 자동 검사하지 않습니다.</p>
    </section>

    <section class="steps" aria-label="단계별 실습">
      <div class="stepsbar"><div><strong id="status-label">01 / 07 · 실습 환경 준비</strong><p id="progress-label">완료 체크 0 / 7</p></div><button class="reset" id="reset-progress" type="button">진도 초기화</button></div>
      <div class="progress-track" role="progressbar" aria-label="자가 점검 완료 비율" aria-valuemin="0" aria-valuemax="7" aria-valuenow="0" id="progress-track"><div id="progress-fill"></div></div>
      <div class="layout">
        <nav id="lesson-nav" class="navsteps" aria-label="실습 단계 목차"></nav>
        <div id="lesson-stack" class="scene-stack"></div>
      </div>
      <script id="lesson-data" type="application/json" set:html={JSON.stringify(scenes)}></script>
    </section>

    <aside class="footwarn"><strong>보안 · 비용</strong><p>Telegram 봇 토큰은 비밀번호처럼 보호하세요. 실제 환자정보, API 키, 인증코드를 공개 강연 화면이나 채팅방에 공유하지 마세요. PC가 꺼지면 Gateway가 응답하지 않을 수 있습니다.</p></aside>
  </div>
</Layout>
<style>
  .lesson{max-width:1060px;margin:auto;padding:20px 22px 85px;color:var(--text)}
  .crumb{display:flex;flex-wrap:wrap;gap:9px;font-size:.81rem;color:var(--t3);margin:8px 0 32px}
  .crumb a{color:var(--t2)}
  .head{border-bottom:1px solid var(--rule);padding:15px 0 31px}
  .eyebrow,.sequence{font-size:.78rem;font-weight:800;letter-spacing:.08em;color:#168f83}
  .head h1{font-size:clamp(2.15rem,5vw,3.7rem);font-family:var(--display);letter-spacing:-.045em;line-height:1.18;margin:12px 0}
  .head h1 em{font-style:normal;color:#0a9787}
  .head>p{font-size:1.1rem;line-height:1.7;color:var(--t2);max-width:700px}
  .headlinks{display:flex;gap:16px;flex-wrap:wrap;margin-top:18px;font-size:.88rem}
  .headlinks a{color:#108879;font-weight:700;text-decoration:underline;text-underline-offset:4px}
  .intro{margin:30px 0 34px}
  .intro h2{font-size:1.33rem;font-family:var(--display);margin:0 0 16px}
  .jump{display:flex;gap:10px;flex-wrap:wrap}
  .jump button,.reset,.pager button,.trouble-footer button{border:1px solid var(--rule);border-radius:7px;padding:10px 12px;color:var(--text);background:var(--bg2);font:inherit;cursor:pointer}
  .jump button:hover,.reset:hover,.pager button:hover{border-color:#14988a}
  .hint{font-size:.83rem;color:var(--t3);margin:11px 0 0;line-height:1.6}
  .stepsbar{display:flex;gap:12px;align-items:center;justify-content:space-between;margin:0 0 10px}
  .stepsbar strong{font-size:1.03rem}.stepsbar p{color:var(--t3);font-size:.83rem;margin:4px 0 0}
  .reset{font-size:.8rem;padding:7px 10px}
  .progress-track{height:5px;background:var(--rule);overflow:hidden;border-radius:4px;margin-bottom:25px}
  #progress-fill{height:100%;width:0;background:#129586;transition:width .2s}
  .layout{display:grid;grid-template-columns:205px minmax(0,1fr);gap:35px;align-items:start}
  .navsteps{position:sticky;top:84px;display:grid;gap:0;border-top:1px solid var(--rule)}
  .stepnav{width:100%;display:flex;align-items:center;gap:10px;text-align:left;border:0;border-bottom:1px solid var(--rule);background:transparent;color:var(--t2);font:inherit;font-size:.87rem;cursor:pointer;padding:12px 6px}
  .stepnav>span:first-child{color:var(--t3);font-size:.75rem;font-weight:800}
  .stepnav.active{font-weight:800;color:#0b8b7f;background:var(--bg2)}
  .stepnav .done{margin-left:auto;display:none;color:#0b8b7f;font-weight:900}
  .stepnav.completed .done{display:block}
  .scene[hidden],.trouble[hidden]{display:none}
  .scene-top{display:flex;align-items:center;justify-content:space-between;gap:10px}
  .surface{font-size:.75rem;color:var(--t2);padding:4px 8px;border:1px solid var(--rule);border-radius:4px}
  .scene h2{font-family:var(--display);font-size:clamp(1.8rem,3.2vw,2.35rem);letter-spacing:-.04em;line-height:1.25;margin:12px 0 20px}
