---
import Layout from '../../../layouts/Layout.astro';

const scenes = [
  {
    id: 'prepare', number: '01', title: '시작 전 준비', location: 'Windows PC · 브라우저',
    objective: '설치에 필요한 PC, 계정, 인터넷, 권한을 확인합니다.',
    why: '시작 전 계정과 설치 권한을 확인하면 실습 중 가장 흔한 중단을 줄일 수 있습니다. 준비가 어려운 사람은 관찰 모드로 따라와도 됩니다.',
    actions: ['Windows 10/11 노트북의 충전 및 인터넷 연결을 확인하세요.', '브라우저에서 본인이 사용할 모델 제공자 계정에 로그인할 수 있는지 확인하세요.', '기관 PC라면 소프트웨어 설치 권한과 보안 정책을 확인하세요.'],
    expected: 'PowerShell을 열 수 있고, 필요한 계정의 인증을 본인이 진행할 수 있습니다.',
    troubleshoot: [
      ['기관 PC에서 설치가 금지됩니다', '정책을 우회하지 말고 실습 관찰 모드로 전환하거나 관리자에게 문의하세요.'],
      ['모델 제공자 계정이 없습니다', '강사의 화면으로 개념을 먼저 학습한 뒤, 사후에 본인이 계정을 준비해 이어 하세요.']
    ]
  },
  {
    id: 'install', number: '02', title: 'Hermes 설치', location: 'PowerShell',
    objective: '공식 설치 스크립트를 확인하고 Hermes를 PC에 설치합니다.',
    why: 'PowerShell에서 설치 명령을 실행하면 Hermes 실행에 필요한 프로그램을 설치할 수 있습니다. 인터넷 스크립트이므로 공식 문서의 주소와 일치하는지 먼저 확인하세요.',
    actions: ['Windows 시작 메뉴에서 PowerShell을 검색하여 실행하세요.', '아래 명령을 공식 출처와 대조한 다음 복사하고 PowerShell에 붙여넣으세요.', '설치 안내에 따라 진행하고 오류가 표시되면 메시지를 확인하세요.'],
    commands: [
      {label:'PowerShell에 붙여넣을 설치 명령', text:'iex (irm https://raw.githubusercontent.com/NousResearch/hermes-agent/main/scripts/install.ps1)'}
    ],
    expected: '설치 작업이 완료되고 다음 설정 또는 설치 종료 안내가 나타납니다. 화면은 Windows 및 Hermes 버전에 따라 달라질 수 있습니다.',
    troubleshoot: [
      ['스크립트가 차단됩니다', '기관 정책이나 보안 프로그램이 차단했다면 임의로 보호 기능을 해제하지 마세요.'],
      ['인터넷 연결 오류가 발생합니다', '인터넷 연결을 확인하고 공식 저장소에 접속되는지 살펴보세요.']
    ]
  },
  {
    id: 'verify', number: '03', title: '설치 상태 확인', location: '새 PowerShell 창',
    objective: 'Hermes가 PC에 정상적으로 설치됐는지 확인합니다.',
    why: '설치 후 PATH 변경이 새 터미널에서 반영되는 경우가 있습니다. 그래서 기존 PowerShell을 닫고 새로 열어 확인합니다.',
    actions: ['기존 PowerShell 창을 닫고 새 PowerShell을 열어 주세요.', '버전 확인 명령을 실행하세요.', '필요하다면 환경 진단 명령을 별도로 실행하세요.'],
    commands: [
      {label:'버전 확인',text:'hermes --version'},
      {label:'추가 환경 진단 (선택)',text:'hermes doctor'}
    ],
    expected: '버전 문자열이 보이면 Hermes 명령이 인식된 것입니다. doctor 경고는 별도로 확인해야 합니다.',
    caution: '버전이 표시되었다고 AI 모델 연결까지 성공한 것은 아닙니다.',
    troubleshoot: [
      ['hermes 명령을 찾을 수 없습니다', '새 PowerShell을 열었는지 확인한 다음, 설치 작업이 실제로 완료됐는지 점검하세요.'],
      ['doctor에 경고가 있습니다', '경고를 읽고 관련 구성요소를 점검하세요. 모든 경고가 모델 응답 실패를 뜻하지는 않습니다.']
    ]
  },
  {
    id: 'model', number: '04', title: '모델과 계정 연결', location: 'PowerShell → 브라우저',
    objective: 'Hermes가 사용할 모델 제공자를 선택하고 본인 계정으로 인증합니다.',
    why: 'Hermes는 에이전트 프로그램이고, 질문에 답하는 모델은 별도로 연결해야 합니다. API 키 인증과 OpenAI Codex 계정 인증은 다를 수 있습니다.',
    actions: ['PowerShell에서 모델 설정 명령을 실행하세요.', '목록에서 OpenAI Codex를 선택하거나 본인이 사용할 모델 제공자를 선택하세요.', '터미널이 안내하는 공식 브라우저 인증 절차를 본인이 직접 진행하세요.', '사용 가능한 모델을 목록에서 선택하세요.'],
    commands: [{label:'모델 설정 시작',text:'hermes model'}],
    expected: '인증을 완료하고 모델을 선택할 수 있습니다. 메뉴·모델 명칭·지원 조건은 버전과 계정별로 달라질 수 있습니다.',
    caution: '로그인 코드, 비밀번호, API 키는 강사·강의 채팅방·AI 대화에 보내지 마세요. 결제 화면이 나오면 이용 조건을 직접 확인하세요.',
    troubleshoot: [
      ['인증 코드가 만료되었습니다', '명령을 다시 실행하고 새로 표시된 인증 절차를 사용하세요.'],
      ['모델이 보이지 않습니다', '계정에서 지원되는 모델과 제공자 선택을 확인하세요.'],
      ['로그인했지만 답변이 오지 않습니다', '다음 단계에서 실제 응답을 테스트한 후 네트워크·모델·인증을 함께 점검하세요.']
    ]
  },
  {
    id: 'response', number: '05', title: '첫 AI 답변 받기', location: 'PowerShell → Hermes 대화',
    objective: '실제로 답변을 받아 오늘의 핵심 목표를 달성합니다.',
    why: '설치·버전 확인·모델 선택은 준비 단계입니다. 질문을 보내고 실제 응답이 돌아왔을 때만 연결을 검증할 수 있습니다.',
    actions: ['PowerShell에서 Hermes를 실행하세요.', 'Hermes 대화 화면이 열리면 한국어 메시지를 입력하세요.', '실제로 AI 답변이 도착하는지 확인하세요.'],
    commands: [
      {label:'PowerShell에서 실행',text:'hermes'},
      {label:'Hermes 대화 화면에 입력',text:'안녕하세요. 앞으로 한국어 존댓말로, 컴퓨터 작업은 한 단계씩 쉽게 설명해 주세요.'}
    ],
    expected: 'Hermes 대화 안에 실제 AI의 한국어 답변이 표시됩니다.',
    caution: '대화 화면이 열렸다는 이유만으로 성공을 체크하지 마세요. 실제 답변이 와야 합니다.',
    troubleshoot: [
      ['답변이 나오지 않습니다', '인터넷 연결, 인증 상태, 사용 가능한 모델을 확인한 후 모델 연결 단계로 돌아가세요.'],
      ['명령이 대화창에서 오류가 납니다', 'hermes 실행 명령은 PowerShell에, 한국어 질문은 Hermes 대화창에 입력하는지 확인하세요.']
    ]
  },
  {
    id: 'personalize', number: '06', title: '내 비서의 행동 원칙 정하기', location: 'Hermes 대화',
    objective: '응답 스타일과 승인 원칙을 스스로 설정합니다.',
    why: '같은 모델이라도 답변 형식과 실행 전 승인 조건을 정하면 내 작업에 더 적합하게 활용할 수 있습니다. 일회성 대화 지시와 영구 파일 설정은 구분해야 합니다.',
    actions: ['Hermes 대화 화면에서 아래 예시를 보내세요.', '다음 답변에 존댓말·단계별 설명 방식이 반영되는지 확인하세요.', '영구 설정은 사후에 SOUL.md를 검토하고 적용해도 됩니다.'],
    commands:[{label:'Hermes 대화 화면에 입력',text:'저를 존댓말로 불러 주세요.\n답변은 결론을 먼저 말하고 필요한 설명을 덧붙여 주세요.\n컴퓨터 작업은 클릭할 곳과 입력할 내용을 한 단계씩 알려 주세요.\n결제, 외부 게시, 파일 삭제나 중요한 설정 변경 전에는 반드시 저에게 확인해 주세요.\n모르면 추측하지 말고 불확실하다고 알려 주세요.'}],
    expected: '이후 답변에서 원하는 말투와 설명 방식이 관찰됩니다. 새 세션에도 유지되는지는 별도로 확인해야 합니다.',
    troubleshoot:[['다음 대화에 설정이 유지되지 않습니다','일회성 대화 요청과 SOUL.md 등 파일 기반 설정은 다를 수 있습니다. 사후 학습에서 실제 저장 상태를 확인하세요.']]
  },
  {
    id:'wrap',number:'07',title:'마무리와 사후 이어 하기',location:'Hermes · 실습 페이지',
    objective:'완료한 항목을 구분하고, 텔레그램 연결 또는 사후 복습으로 이동합니다.',
    why:'일부 참가자는 인증이나 설치 권한 때문에 같은 속도로 진행하기 어렵습니다. 지금 어디까지 왔는지 남기면 강연 이후에도 이어 할 수 있습니다.',
    actions:['설치 명령 인식과 실제 AI 응답이 서로 다른 결과라는 점을 다시 확인하세요.', '아직 답변을 받지 못했다면 관련 단계의 문제 해결 섹션으로 돌아가세요.', '실제 답변을 받았다면 텔레그램 연결 원본 가이드를 참고해 다음 실습으로 진행할 수 있습니다.'],
    commands:[{label:'다시 대화 시작 (PowerShell)',text:'hermes'}],
    expected:'자신이 완료한 단계가 정리되고, 남은 작업이 분명해집니다.',
    troubleshoot:[['진도 표시가 사라졌습니다','진도는 이 브라우저에만 저장될 수 있습니다. 시크릿 모드, 다른 PC, 브라우저 데이터 삭제 후에는 보존되지 않을 수 있습니다.']]
  }
];
---
<Layout title="Hermes Agent EP01 · 직접 따라 하는 설치 실습" description="강세희 원장 Hermes Agent 강연용 대화형 실습: PowerShell 설치, 모델 인증, 첫 AI 응답과 문제 해결" noindex={true}>
<link rel="stylesheet" href="/tutorials/hermes-agent/lesson-ui.css" />
  <div class="lesson">
    <nav class="crumb" aria-label="현재 위치"><a href="/tutorials/">튜토리얼</a><span>/</span><a href="/tutorials/hermes-agent/">Hermes Agent</a><span>/</span><strong>EP01</strong></nav>
    <header class="head">
      <span class="eyebrow">HERMES AGENT · HANDS-ON · EP.01</span>
      <h1>PC에서 <em>AI와 대화 시작하기</em></h1>
      <p>Hermes 설치부터 AI 모델 연결, 첫 대화까지 차근차근 따라 해보세요.</p>
      <div class="headlinks"><a href="/tutorials/hermes-agent/">강연 자료실</a><a href="/downloads/hermes-agent/Hermes_Agent_설치와_시작_통합가이드_아잉이.md" download>원본 가이드 다운로드 ↓</a></div>
    </header>

    <section class="intro">
      <h2>어디부터 시작하면 될까요?</h2>
      <div class="jump" aria-label="현재 학습 상태 선택">
        <button type="button" data-jump="prepare">처음 설치해요</button>
        <button type="button" data-jump="verify">설치했는데 막혔어요</button>
        <button type="button" data-jump="response">모델 연결까지 마쳤어요</button>
      </div>
      <p class="hint">현재 진행 상황에 맞는 단계를 선택하세요. PC 설치 상태는 자동으로 확인하지 않습니다.</p>
    </section>

    <section class="steps" aria-label="단계별 실습">
      <div class="stepsbar"><div><strong id="status-label">01 / 07 · 시작 전 준비</strong><p id="progress-label">완료한 단계 0/7</p></div><button class="reset" id="reset-progress" type="button">진도 초기화</button></div>
      <div class="progress-track" role="progressbar" aria-label="자가 점검 완료 비율" aria-valuemin="0" aria-valuemax="7" aria-valuenow="0" id="progress-track"><div id="progress-fill"></div></div>
      <div class="layout">
        <nav id="lesson-nav" class="navsteps" aria-label="실습 단계 목차"></nav>
        <div id="lesson-stack" class="scene-stack"></div>
      </div>
      <script id="lesson-data" type="application/json" set:html={JSON.stringify(scenes)}></script>
    </section>

    <aside class="footwarn"><strong>보안 · 비용</strong><p>설치 명령은 인터넷에서 스크립트를 받아 실행합니다. 공식 주소를 확인하세요. 인증 코드, API 키, 환자정보는 강연 채팅·AI 대화에 공유하지 마세요. 모델 제공자에 따라 별도 이용 조건이나 비용이 적용될 수 있습니다.</p></aside>
  </div>
</Layout>

<script is:inline src="/tutorials/hermes-agent/runtime.js"></script>
<script is:inline src="/tutorials/hermes-agent/ep01-interactions.js"></script>