---
import Layout from '../../../../layouts/Layout.astro';
const points = [
  {
    "id": "PP01",
    "title": "고객 이해·상담 준비",
    "question": "고객이 원하는 것을 충분히 확인했는가?",
    "symptom": "상담 기록이 길지만 고객의 가장 큰 고민, 기대 효과, 실제 결정 여부를 한눈에 알기 어렵습니다.",
    "impact": "담당자가 바뀔 때 같은 질문을 반복하고, 확인되지 않은 의향을 확정된 선택으로 오해할 수 있습니다.",
    "cause": "상담 중 드러나는 관심사·의학적 질문·개인 선호·시술 동의를 한 문장으로 혼합해 기록하기 때문입니다.",
    "ai": "긴 가상 상담에서 사실·희망·질문·미확인을 나누고 다음 상담 질문을 초안으로 만듭니다.",
    "human": "의료 적합성 판단, 개인정보 접근 범위, 실제 동의와 시술 결정은 의료진과 고객이 확인합니다.",
    "examples": [
      "긴 상담에서 핵심 고민 추리기",
      "통증 우려와 시술 기대치 구분",
      "진료 사진과 홍보 사진의 동의 분리"
    ],
    "practice": "PP01-01"
  },
  {
    "id": "PP02",
    "title": "문의·예약·결정",
    "question": "문의, 예약, 결제를 같은 단계로 취급하지 않는가?",
    "symptom": "카카오톡 문의가 예약으로 잘못 분류되거나, 예약금 입금 예정이 결제 완료로 기록됩니다.",
    "impact": "예약 공백·중복 예약·고객 의사와 다른 후속 연락으로 이어질 수 있습니다.",
    "cause": "문의 접수, 시간 확정, 방문, 결제 등 상태와 그 근거가 구분되지 않았기 때문입니다.",
    "ai": "가상 대화에서 문의·미결정·확정·취소를 분류하고 미확인 상태 및 후속 질문을 제안합니다.",
    "human": "예약 변경·취소 결정, 고객 연락 거절과 마케팅 수신 동의의 준수는 담당자가 확인합니다.",
    "examples": [
      "문의와 예약 확정 구분",
      "동일 시간대 예약 충돌 확인",
      "추가 연락 거절 의사 기록"
    ],
    "practice": "PP02-01"
  },
  {
    "id": "PP03",
    "title": "의료 안전·사후관리",
    "question": "불편감의 진술과 의학적 판단을 혼동하지 않는가?",
    "symptom": "시술 후 불편감, 복용약, 알레르기, 증상 시작 시점이 불완전하게 기록되기 쉽습니다.",
    "impact": "중요한 정보가 의료진에게 누락되거나, 의료적으로 긴급한 상황에 대응이 지연될 수 있습니다.",
    "cause": "환자 진술, 관찰 내용, 확인된 의료 사실, 추측이 혼합되기 때문입니다.",
    "ai": "가상 사례의 증상·시간·미확인 정보를 구조화하고 의료진 인계에 필요한 질문을 제안합니다.",
    "human": "진단, 중증도 판단, 시술 여부, 응급 대응은 AI가 결정하지 않습니다. 호흡곤란 등 응급 신호는 즉시 적절한 의료 대응이 우선입니다.",
    "examples": [
      "불확실한 과거 불편감 구분",
      "시술 후 증상 인계 항목 정리",
      "응급 신호의 즉시 대응"
    ],
    "practice": "PP03-01"
  },
  {
    "id": "PP04",
    "title": "직원·운영 개선",
    "question": "개인 실수보다 업무 흐름 자체의 병목을 찾았는가?",
    "symptom": "상담 메모 재작성, 반복 질문, 직원별 다른 안내문 사용과 인계 누락이 발생합니다.",
    "impact": "반복 작업이 늘고 교육 품질이 달라지며 상담·예약 과정의 오류 가능성이 커집니다.",
    "cause": "업무 책임자·완료 기준·승인된 안내문 버전·측정 지표가 정리되지 않았기 때문입니다.",
    "ai": "반복 업무를 분류하고 체크리스트 초안, 책임 구분, 측정 항목과 개선 실험을 제안합니다.",
    "human": "업무 규정 승인, 의료 설명 검토, 직원 교육과 변경 관리 책임은 조직에 남아 있습니다.",
    "examples": [
      "직원 인계 누락 경로 파악",
      "오래된 안내문 버전 정리",
      "자동화 우선순위 비교"
    ],
    "practice": "PP04-01"
  },
  {
    "id": "PP05",
    "title": "경영·데이터 분석",
    "question": "숫자의 정의와 분모를 확인한 뒤 결론을 내리는가?",
    "symptom": "매출, 결제, 환불, 방문, 고유 고객 수, 전환율이 하나의 숫자처럼 비교됩니다.",
    "impact": "중복 결제나 결측값 때문에 KPI가 왜곡되고 잘못된 경영 결정을 내릴 수 있습니다.",
    "cause": "데이터 한 행의 의미, 고유 ID, 계산 기간, 환불 처리 기준 및 결측값 규칙이 명시되지 않았기 때문입니다.",
    "ai": "합성 자료에서 집계 기준과 데이터 품질 문제를 찾고 검산할 질문을 제시합니다.",
    "human": "회계 기준 확정, 실제 원장·결제 정보 검산, 투자·마케팅 의사결정은 사람이 맡습니다.",
    "examples": [
      "방문 수와 고유 고객 수 구분",
      "중복 결제 ID 점검",
      "상담 전환율의 분모 정의"
    ],
    "practice": "PP05-01"
  },
  {
    "id": "PP06",
    "title": "환자 경험·관계관리",
    "question": "상담이 끝난 뒤 고객은 다음에 무엇을 해야 하는지 알고 있는가?",
    "symptom": "설명 자료를 보내도 실제 이해 여부는 알지 못하거나, 사후관리 안내 기록이 빠지고 미결정 고객에게 불필요한 연락이 예정됩니다.",
    "impact": "고객은 다시 질문해야 하고, 다음 방문 준비가 혼란스러워질 수 있습니다. 지나친 재접촉은 신뢰를 해칠 수 있습니다.",
    "cause": "안내 전송·이해 확인·재문의·재방문 관심·예약 확정을 하나의 상태로 다루기 때문입니다.",
    "ai": "가상 여정 기록에서 안내 누락이나 미확인 상태를 표시하고, 이해도 확인 질문과 담당자 검토 목록을 정리합니다.",
    "human": "연락 동의·시술 후 개인별 의학적 안내·실제 고객 발송 여부는 담당자가 확인하고 승인합니다.",
    "examples": [
      "상담 후 설명 이해도 확인",
      "사후관리 안내 누락 점검",
      "재방문 관심과 예약 확정 구분"
    ],
    "practice": "PP06-01"
  },
  {
    "id": "PP07",
    "title": "개인정보·동의·보안",
    "question": "정보를 보유하고 있다는 이유만으로 공유하거나 활용해도 되는가?",
    "symptom": "진료 촬영 동의를 홍보 활용과 혼동하거나, 상담 메모가 전 직원에게 공개되고, 이름을 지운 자료를 익명이라고 잘못 판단할 수 있습니다.",
    "impact": "민감정보가 불필요하게 노출되거나 고객의 동의 범위를 벗어난 사용이 일어날 수 있습니다.",
    "cause": "정보 수집 목적, 목적별 동의, 보유 기간, 접근 권한, 직접·간접 식별 가능성을 분리하지 않기 때문입니다.",
    "ai": "합성 데이터로 정보 최소화·승인 체크리스트·접근 권한 점검 항목을 만드는 연습을 합니다.",
    "human": "실제 환자 자료의 외부 AI 업로드는 이 실습에서 금지합니다. 적법한 처리와 동의 여부는 담당자가 제도와 정책에 따라 검토해야 합니다.",
    "examples": [
      "민감한 상담 정보의 접근 범위",
      "상담·시술 기록의 정정·삭제 요청 처리",
      "외부 AI 업로드 전 정보 최소화"
    ],
    "practice": "PP07-01"
  },
  {
    "id": "PP08",
    "title": "AI 활용 품질·자동화 관리",
    "question": "AI가 그럴듯하게 답했을 때 무엇으로 정확성을 검증할 것인가?",
    "symptom": "AI가 원문에 없는 결정을 추가하거나 프롬프트 수정 후 결측값을 임의 보정하고, 미검토 메시지가 자동 전송될 수 있습니다.",
    "impact": "허위 정보가 기록에 반영되거나 자동화 오류가 반복·확산될 수 있습니다.",
    "cause": "출처 연결, 합성 테스트셋, 검토·승인 단계, 감사 로그 및 실패 시 중단 규칙이 부족하기 때문입니다.",
    "ai": "가상 원문과 모델 출력을 대조하고 오류 유형·재현 조건·테스트 케이스·중단 기준을 체계화합니다.",
    "human": "의료·고객 커뮤니케이션·경영상 중요한 결정과 실제 발송은 담당자가 최종 승인합니다.",
    "examples": [
      "AI 요약의 원문과 다른 내용 검증",
      "프롬프트 변경 전후 동일 테스트셋 비교",
      "자동 메시지 승인·발송 분리"
    ],
    "practice": "PP08-01"
  }
];
---
<Layout title="페인 포인트 이해하기 | CRM AI 실습" description="PP01~PP08의 병원 CRM 페인 포인트를 원인, 현장 증상, AI 활용 범위, 검증 방식으로 이해합니다.">
  <div class="pp-shell">
    <nav class="breadcrumb" aria-label="현재 위치"><a href="/">홈</a><span>›</span><a href="/lecture-materials/kim-dowi/">김도위 원장 강연</a><span>›</span><a href="/tutorials/crm-scenarios/">CRM AI 실습 라이브러리</a><span>›</span><strong>페인 포인트 이해</strong></nav>
    <header class="pp-header"><p class="eyebrow">S—REBORN · CRM AI LEARNING</p><h1>실습 전에, 어떤 문제를 해결하는지부터 이해합니다.</h1><p>페인 포인트(Pain Point)는 고객·직원·병원 운영에서 반복적으로 나타나는 어려움이나 손실의 원인입니다. 단순히 불편한 현상을 나열하는 것이 아니라 <b>현상 → 원인 → 확인해야 할 사실 → 해결 가능한 행동</b>으로 설명합니다.</p><div class="top-actions"><a class="primary" href="/tutorials/crm-scenarios/">전체 실습 바로 시작하기 →</a><a class="secondary" href="#PP01">PP01부터 살펴보기 ↓</a></div></header>
    <section class="guide"><h2>번호는 어떻게 읽나요?</h2><p><strong>PP02</strong>는 두 번째 페인 포인트 영역, <strong>PP02-04</strong>는 그 영역에 속한 네 번째 실습입니다. 번호는 학습 난이도나 우선순위를 뜻하지 않으며, 실습이 늘어나도 이미 부여한 번호는 유지됩니다.</p><p>실제 환자 자료를 외부 AI에 올리지 않고, 제공된 가상 자료로만 연습합니다. AI 답변은 원문과 비교해서 검증하고, 의료 판단은 의료진에게 인계합니다.</p></section>
    <nav class="point-nav" aria-label="페인 포인트 바로가기">{points.map(p => <a href={'#'+p.id}><strong>{p.id}</strong><span>{p.title}</span></a>)}</nav>
    {points.map(p => <article class="point" id={p.id}>
      <div class="point-title"><span class="code">{p.id}</span><h2>{p.title}</h2></div>
      <p class="question">{p.question}</p>
      <div class="explain-grid"><section><h3>현장에서는 어떻게 나타날까요?</h3><p>{p.symptom}</p></section><section><h3>왜 문제가 될까요?</h3><p>{p.impact}</p></section><section><h3>어떤 원인을 확인해야 하나요?</h3><p>{p.cause}</p></section><section><h3>AI는 무엇을 도울까요?</h3><p>{p.ai}</p></section></div>
      <div class="human"><strong>사람이 최종적으로 확인해야 하는 일</strong><p>{p.human}</p></div>
      <h3 class="examples-title">대표 실습 주제</h3><ul>{p.examples.map(e=><li>{e}</li>)}</ul>
      <div class="bottom-actions"><a class="primary" href={'/tutorials/crm-scenarios/#'+p.practice}>{p.id} 첫 실습 시작하기 →</a><a class="secondary" href="/tutorials/crm-scenarios/">전체 시나리오 검색하기</a></div>
    </article>)}
    <footer class="pp-footer">학습 흐름: 문제 이해 → 가상 원문 확인 → AI 정리 → 근거 검증 → 실제 적용 전 담당자 승인</footer>
  </div>
</Layout>
<style>
.pp-shell{max-width:1040px;margin:auto;padding:24px 0 64px;color:var(--text)}.pp-shell *{box-sizing:border-box}
.pp-shell a{color:inherit}.breadcrumb{display:flex;flex-wrap:wrap;align-items:center;gap:8px;font-size:.82rem;color:var(--t2);margin-bottom:28px}.breadcrumb a{text-decoration:underline;text-underline-offset:3px}.pp-header{padding:26px 28px;border-radius:12px;background:var(--bg2);border:1px solid var(--rule)}.eyebrow{font-weight:800;letter-spacing:.08em;font-size:.79rem;color:var(--t2);margin-bottom:10px}.pp-header h1{font-size:clamp(1.6rem,3.6vw,2.5rem);line-height:1.3;margin:0 0 12px}.pp-header p{line-height:1.75;color:var(--t2)}.pp-header p b{color:var(--text)}.top-actions,.bottom-actions{display:flex;flex-wrap:wrap;gap:9px;margin-top:20px}.primary,.secondary{display:inline-flex;align-items:center;min-height:43px;padding:10px 15px;border-radius:7px;text-decoration:none;font-weight:700;border:1px solid var(--rule)}.primary{background:#087b71;color:white!important;border-color:#087b71}.secondary{background:var(--bg);color:var(--text)}.primary:hover{background:#08625c}.secondary:hover,.point-nav a:hover{border-color:#169789}.guide,.point{background:var(--bg2);border:1px solid var(--rule);border-radius:12px;padding:22px 24px;margin:20px 0}.guide h2{font-size:1.3rem;margin:0 0 8px}.guide p{color:var(--t2);line-height:1.8;margin:10px 0}.guide strong{color:var(--text)}.point-nav{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px;margin:20px 0}.point-nav a{display:flex;flex-direction:column;gap:5px;padding:13px 10px;background:var(--bg2);border:1px solid var(--rule);border-radius:8px;text-decoration:none;font-size:.83rem}.point-nav strong,.code{font-size:.95rem;font-weight:850;color:#069988}.point-nav span{color:var(--text)}.point{scroll-margin-top:80px}.point-title{display:flex;align-items:center;gap:12px;flex-wrap:wrap}.code{border:1px solid var(--rule);padding:4px 8px;border-radius:6px}.point-title h2{margin:0;font-size:1.45rem}.question{font-size:1.1rem;font-weight:750;margin:14px 0 20px}.explain-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.explain-grid section{padding:16px;background:var(--bg);border:1px solid var(--rule);border-radius:8px}.explain-grid h3,.examples-title{font-size:1rem;margin:0 0 8px}.explain-grid p,.human p{color:var(--t2);line-height:1.75;margin:0}.human{background:var(--bg);border-left:3px solid #0f9387;padding:13px 16px;margin:15px 0;border-radius:4px}.human strong{display:block;margin-bottom:6px}.point ul{padding-left:22px;line-height:1.9;color:var(--t2)}.pp-footer{font-size:.88rem;color:var(--t2);border-top:1px solid var(--rule);padding-top:24px;margin-top:28px}
:global(html[data-theme="dark"]) .point-nav strong,:global(html[data-theme="dark"]) .code{color:#5ddcc9}
@media(max-width:760px){.point-nav{grid-template-columns:repeat(2,minmax(0,1fr))}.explain-grid{grid-template-columns:1fr}.pp-header{padding:20px}.guide,.point{padding:18px}}
</style>
