---
/*
  운영 브랜드 홈. 글 목록·아카데미·소개는 실제 주소다.
  포털 시범: 검색을 중앙에 두고, 카드 대신 읽어 내려가는 목록을 쓴다.
*/
import { getCollection } from 'astro:content';
import BrandIcons from '../components/preview/BrandIcons.astro';
import BlogSearchScript from '../components/BlogSearchScript.astro';
import FormattedDate from '../components/FormattedDate.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { CATEGORIES, CONTACT_EMAIL, MENU_GROUPS } from '../consts';
import { ACADEMY_URL } from '../data/site-nav';
import { portalCopy } from '../i18n/ui';
import { buildSearchIndex } from '../lib/search-index';
import '../styles/brand-home.css';

const copy = portalCopy('ko');
const searchIndex = await buildSearchIndex();
const BLOG_INDEX = '/blog/';
const ABOUT_HREF = '/about/';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const byId = new Map(allPosts.map((post) => [post.id, post]));

const featuredIds = ['aerini/what-is-ai', 'orchestration/workflow-patterns', 'orchestration/what-is-orchestration'] as const;
const featuredLabels = ['AI FUNDAMENTALS', 'WORKFLOW', 'RESEARCH NOTES'] as const;

const featured = featuredIds.flatMap((id, index) => {
	const post = byId.get(id);
	if (!post) {
		console.warn(`[home] 추천 글을 찾지 못해 건너뜁니다: ${id}`);
		return [];
	}
	return [{
		href: `/blog/${post.id}/`,
		title: post.data.title,
		description: post.data.description,
		label: featuredLabels[index],
	}];
});

const countsByCategory = allPosts.reduce<Record<string, number>>((acc, post) => {
	const category = post.data.category;
	if (category) acc[category] = (acc[category] ?? 0) + 1;
	return acc;
}, {});

const categoryBlocks = MENU_GROUPS.map((group) => ({
	id: group.id,
	label: group.label,
	cats: group.cats.flatMap((catId) => {
		const cat = CATEGORIES.find((item) => item.id === catId);
		const count = countsByCategory[catId] ?? 0;
		if (!cat || count === 0) return [];
		return [{ id: catId, label: cat.label, count }];
	}),
})).filter((group) => group.cats.length > 0);

const knownCategoryIds = new Set<string>(MENU_GROUPS.flatMap((group) => [...group.cats]));
const otherCategories = CATEGORIES.flatMap((cat) => {
	if (knownCategoryIds.has(cat.id)) return [];
	const count = countsByCategory[cat.id] ?? 0;
	if (count === 0) return [];
	return [{ id: cat.id, label: cat.label, count }];
});

const latest = allPosts.slice(0, 8);
const categoryLabel = (id: string) => CATEGORIES.find((cat) => cat.id === id)?.label ?? id;
---

<!doctype html>
<html lang="ko">
	<head>
		<script is:inline src="/assets/sreborn-theme-init.js"></script>
<link rel="stylesheet" href="/assets/sreborn-theme-tokens.css" />
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>S—REBORN | Kim Dowi's AI Lab</title>
		<meta name="description" content="김도위의 AI 연구, 콘텐츠, 아카데미를 연결하는 공간." />
		<BrandIcons />
	</head>
	<body>
		<SiteHeader showSearch compactSearch />
		<div class="shell">
			<main class="portal-main" id="top">
				<section class="hero">
					<div class="eyebrow"><span class="dot"></span> KIM DOWI'S AI LAB & JOURNAL</div>
					<h1>AI를 이해하고, <span class="accent">실험하고,</span> 현실에 적용합니다.</h1>
					<p class="hero-desc">의사 김도위의 AI 연구, 생각, 실험 그리고 교육. 기술을 아는 것에서 멈추지 않고, 실제 변화를 만드는 과정을 기록합니다.</p>
					<form class="portal-search" data-search-wrap action={BLOG_INDEX} method="get" role="search">
						<label class="sr-only" for="portal-query">{copy.searchLabel}</label>
						<input id="portal-query" data-search-mirror name="q" type="search" placeholder={copy.searchPlaceholder} autocomplete="off" enterkeyhint="search" />
						<button type="submit">{copy.searchSubmit}</button>
					</form>
					<div class="hero-actions">
						<a class="primary" href="#explore">공간 둘러보기 <span>↗</span></a>
						<a class="secondary" href={ABOUT_HREF}>김도위 소개 ↗</a>
						<a class="secondary" href="/academy/mini-lab/" style="border-color:var(--site-mint);background:var(--site-surface);color:var(--site-text);">AI 미니 아카데미 · 실습 시연 ↗</a>
					</div>
					<div class="hero-note">RESEARCH · IDEAS · PRACTICE · EDUCATION</div>
				</section>

				<section class="section" id="explore">
					<div class="section-head">
						<div>
							<div class="overline">01 / EXPLORE</div>
							<h2>생각에서 실천까지</h2>
						</div>
						<p class="section-intro">하나의 질문에서 시작된 연구가 콘텐츠가 되고, 실제로 활용할 수 있는 배움으로 이어집니다.</p>
					</div>
					<ul class="portal-rows">
						<li>
							<a class="portal-row" href="#research">
								<span>
									<span class="portal-kicker">01 — RESEARCH</span>
									<span class="portal-title">AI 연구</span>
									<small class="portal-copy">AI를 어떻게 더 잘 이해하고 활용할 수 있을지 실험하고 체계화합니다.</small>
								</span>
								<span aria-hidden="true">↗</span>
							</a>
						</li>
						<li>
							<a class="portal-row" href={BLOG_INDEX}>
								<span>
									<span class="portal-kicker">02 — JOURNAL</span>
									<span class="portal-title">AI 콘텐츠</span>
									<small class="portal-copy">낯선 개념부터 현장 적용까지, 축적한 지식을 읽기 쉽게 공유합니다.</small>
								</span>
								<span aria-hidden="true">↗</span>
							</a>
						</li>
						<li>
							<a class="portal-row" href={ACADEMY_URL} target="_blank" rel="noopener noreferrer">
								<span>
									<span class="portal-kicker">03 — ACADEMY</span>
									<span class="portal-title">AI 아카데미</span>
									<small class="portal-copy">단순한 기능 소개를 넘어, 스스로 활용할 수 있도록 배우고 실습합니다.</small>
								</span>
								<span aria-hidden="true">↗</span>
							</a>
						</li>
					</ul>
				</section>

				<section class="section" id="categories" aria-labelledby="category-title">
					<div class="section-head">
						<div>
							<div class="overline">INDEX</div>
							<h2 id="category-title">{copy.categoryTitle}</h2>
						</div>
						<p class="section-intro">{copy.categoryLead}</p>
					</div>
					{categoryBlocks.map((group) => (
						<div class="portal-group">
							<h3><a href={`${BLOG_INDEX}?group=${group.id}`}>{group.label}</a></h3>
							<ul class="portal-rows">
								{group.cats.map((cat) => (
									<li>
										<a class="portal-row" href={`${BLOG_INDEX}?category=${cat.id}`}>
											<span class="portal-title">{cat.label}</span>
											<span class="portal-count">{cat.count}{copy.countUnit}</span>
										</a>
									</li>
								))}
							</ul>
						</div>
					))}
					{otherCategories.length > 0 && (
						<div class="portal-group">
							<h3>{copy.otherGroup}</h3>
							<ul class="portal-rows">
								{otherCategories.map((cat) => (
									<li>
										<a class="portal-row" href={`${BLOG_INDEX}?category=${cat.id}`}>
											<span class="portal-title">{cat.label}</span>
											<span class="portal-count">{cat.count}{copy.countUnit}</span>
										</a>
									</li>
								))}
							</ul>
						</div>
					)}
				</section>

				<section class="section" id="latest" aria-labelledby="latest-title">
