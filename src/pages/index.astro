---
/*
  운영 브랜드 홈. 글 목록·아카데미·소개는 실제 주소다.
  포털 시범: 검색을 중앙에 두고, 카드 대신 읽어 내려가는 목록을 쓴다.
*/
import { getCollection } from 'astro:content';
import BrandIcons from '../components/preview/BrandIcons.astro';
import BlogSearchScript from '../components/BlogSearchScript.astro';
import FormattedDate from '../components/FormattedDate.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { CATEGORIES, CONTACT_EMAIL } from '../consts';
import { portalCopy } from '../i18n/ui';
import { buildSearchIndex } from '../lib/search-index';
import '../styles/brand-home.css';

const copy = portalCopy('ko');
const searchIndex = await buildSearchIndex();
const BLOG_INDEX = '/blog/';
const ABOUT_HREF = '/about/';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const byId = new Map(allPosts.map((post) => [post.id, post]));

const featuredIds = ['aerini/what-is-ai', 'orchestration/workflow-patterns', 'orchestration/what-is-orchestration'] as const;

const featuredPosts = featuredIds.flatMap((id) => {
	const post = byId.get(id);
	if (!post) {
		console.warn(`[home] 추천 글을 찾지 못해 건너뜁니다: ${id}`);
		return [];
	}
	return [post];
});
const featuredIdSet = new Set(featuredPosts.map((post) => post.id));
const reading = [...featuredPosts, ...allPosts.filter((post) => !featuredIdSet.has(post.id))].slice(0, 8);
const categoryLabel = (id: string) => CATEGORIES.find((cat) => cat.id === id)?.label ?? id;
---

<!doctype html>
<html lang="ko">
	<head>
		<script is:inline src="/assets/sreborn-theme-init.js"></script>
<link rel="stylesheet" href="/assets/sreborn-theme-tokens.css" />
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>S—REBORN | Kim Dowi's AI Lab</title>
		<meta name="description" content="김도위의 AI 연구, 콘텐츠, 아카데미를 연결하는 공간." />
		<BrandIcons />
	</head>
	<body>
		<SiteHeader showSearch compactSearch />
		<div class="shell">
			<main class="portal-main" id="top">
				<section class="hero">
					<div class="eyebrow"><span class="dot"></span> KIM DOWI'S AI LAB & JOURNAL</div>
					<h1>AI를 이해하고, <span class="accent">실험하고,</span> 현실에 적용합니다.</h1>
					<p class="hero-desc">의사 김도위의 AI 연구, 생각, 실험 그리고 교육. 기술을 아는 것에서 멈추지 않고, 실제 변화를 만드는 과정을 기록합니다.</p>
					<form class="portal-search" data-search-wrap action={BLOG_INDEX} method="get" role="search">
						<label class="sr-only" for="portal-query">{copy.searchLabel}</label>
						<input id="portal-query" data-search-mirror name="q" type="search" placeholder={copy.searchPlaceholder} autocomplete="off" enterkeyhint="search" />
						<button type="submit">{copy.searchSubmit}</button>
					</form>
					<p class="portal-inline-links" id="explore">
						<a href={ABOUT_HREF}>김도위 소개</a>
						<a href="/academy/mini-lab/">AI 미니 아카데미 · 실습 시연</a>
						<a href={BLOG_INDEX}>전체 글</a>
					</p>
					<div class="hero-note">RESEARCH · IDEAS · PRACTICE · EDUCATION</div>
				</section>

				<section class="section" id="categories">
					<ul class="portal-rows">
						<li>
							<a class="portal-row" href={BLOG_INDEX}>
								<span class="portal-title">{copy.categoryIndexLink}</span>
								<span aria-hidden="true">↗</span>
							</a>
						</li>
					</ul>
				</section>

				<section class="section" id="latest">
					<div class="section-head">
						<div>
							<div class="overline">RECENT</div>
							<h2 id="writing">{copy.latestTitle}</h2>
						</div>
						<p class="section-intro">{copy.latestLead}</p>
					</div>
					<ul class="portal-rows">
						{reading.map((post) => (
							<li>
								<a class="portal-row portal-row-post" href={`/blog/${post.id}/`}>
									<span class="portal-title">{post.data.title}</span>
									<span class="portal-date"><FormattedDate date={post.data.date} /></span>
									<span class="portal-meta">
										{post.data.category && <span>{categoryLabel(post.data.category)}</span>}
										{post.data.description && <small>{post.data.description}</small>}
									</span>
								</a>
							</li>
						))}
						<li>
							<a class="portal-row" href={BLOG_INDEX}>
								<span class="portal-title">{copy.allPosts}</span>
								<span aria-hidden="true">↗</span>
							</a>
						</li>
					</ul>
				</section>

				<section class="section" id="shortcuts" aria-labelledby="shortcut-title">
					<div class="section-head">
						<div>
							<div class="overline">GO TO</div>
							<h2 id="shortcut-title">{copy.shortcutTitle}</h2>
						</div>
						<p class="section-intro">{copy.shortcutLead}</p>
					</div>
					<div class="portal-group">
						<h3>{copy.lectureGroup}</h3>
						<ul class="portal-rows">
							<li><a class="portal-row" href="/lecture-materials/"><span class="portal-title">{copy.lectureHome}</span><span aria-hidden="true">↗</span></a></li>
							<li><a class="portal-row" href="/lectures/"><span class="portal-title">{copy.lectureList}</span><span aria-hidden="true">↗</span></a></li>
							<li><a class="portal-row" href="/lecture-materials/archive/"><span class="portal-title">{copy.lecturePractice}</span><span aria-hidden="true">↗</span></a></li>
						</ul>
					</div>
					<div class="portal-group" id="academy">
						<h3>{copy.academyGroup}</h3>
						<ul class="portal-rows">
							<li><a class="portal-row" href="/academy/mini-lab/"><span class="portal-title">AI 미니 아카데미 · 실습 시연</span><span aria-hidden="true">↗</span></a></li>
							<li><a class="portal-row" href="/tutorials/codex-cli-windows/"><span class="portal-title">초보자 Codex CLI 설치 · 단계별 실습</span><span aria-hidden="true">↗</span></a></li>
							<li><a class="portal-row" href="/academy/agent-orchestration-20261108/"><span class="portal-title">오늘의 미니 아카데미 · CLI / Agent / Orchestration</span><span aria-hidden="true">↗</span></a></li>
						</ul>
					</div>
					<div class="portal-group">
						<h3>{copy.crmGroup}</h3>
						<ul class="portal-rows">
							<li><a class="portal-row" href="/tutorials/crm-scenarios/"><span class="portal-title">{copy.crmGroup}</span><span aria-hidden="true">↗</span></a></li>
							<li><a class="portal-row" href="/tutorials/crm-scenarios/pain-points/"><span class="portal-title">{copy.crmGuide}</span><span aria-hidden="true">↗</span></a></li>
						</ul>
					</div>
				</section>

				<section class="section" id="research">
					<div class="section-head">
						<div>
							<div class="overline">02 / CURRENT RESEARCH</div>
							<h2>AI를 사용하는 방법 그 자체를 연구합니다.</h2>
						</div>
						<p class="section-intro">다중 AI 협업부터 사람과 AI의 상호작용까지. 지속적으로 발전하는 연구와 프로젝트의 기록입니다.</p>
					</div>
					<ul class="portal-rows">
						<li>
							<a class="portal-row" href="/blog/orchestration/what-is-orchestration/">
								<span>
									<span class="portal-title">Multi-AI Operating System</span>
									<small class="portal-copy">여러 AI를 하나의 작업 흐름으로 연결하는 실험</small>
								</span>
								<span aria-hidden="true">↗</span>
							</a>
						</li>
						<li>
							<a class="portal-row" href="/blog/orchestration/human-in-the-loop/">
								<span>
									<span class="portal-title">Human–AI Cognitive Interface</span>
									<small class="portal-copy">인간과 AI의 소통 및 인지 구조에 관한 연구</small>
								</span>
								<span aria-hidden="true">↗</span>
							</a>
						</li>
						<li>
							<a class="portal-row" href="/blog/orchestration/workflow-patterns/">
								<span>
									<span class="portal-title">AI Workflow Engineering</span>
									<small class="portal-copy">반복 업무를 지식과 시스템으로 전환하는 방법</small>
								</span>
								<span aria-hidden="true">↗</span>
							</a>
						</li>
						<li>
							<a class="portal-row" href="/blog/?category=orchestration">
								<span class="portal-title">{copy.orchestrationMore}</span>
								<span aria-hidden="true">↗</span>
							</a>
						</li>
					</ul>
				</section>

				<section class="openchat-section" id="openchat" aria-labelledby="openchat-title">
					<div class="openchat-copy">
						<div class="overline">05 / COMMUNITY</div>
						<h2 id="openchat-title">에스리본의원 MDAI 커뮤니티</h2>
						<p>의료 현장에서 AI를 배우고 활용하는 분들을 위한 카카오톡 오픈채팅방입니다. AI 실무 사례와 교육 소식을 함께 나눕니다.</p>
						<a class="openchat-button" href="https://open.kakao.com/o/pkFCQiii?rt=Q" target="_blank" rel="noopener noreferrer" aria-label="에스리본의원 MDAI 카카오톡 오픈채팅방 입장">오픈톡방 참여하기 <span aria-hidden="true">↗</span></a>
						<small>휴대전화에서는 버튼을 누르고, PC에서는 오른쪽 QR코드를 스캔하세요.</small>
					</div>
					<a class="openchat-qr" href="https://open.kakao.com/o/pkFCQiii?rt=Q" target="_blank" rel="noopener noreferrer" aria-label="QR코드로 에스리본의원 MDAI 오픈톡방 입장">
						<img src="https://api.qrserver.com/v1/create-qr-code/?size=240x240&amp;margin=12&amp;data=https%3A%2F%2Fopen.kakao.com%2Fo%2FpkFCQiii%3Frt%3DQ" alt="에스리본의원 MDAI 오픈톡방 참여 QR코드" loading="lazy" width="200" height="200" />
						<span>카메라로 스캔해 입장</span>
					</a>
				</section>

				<section class="about about-teaser" id="about">
					<figure class="about-figure">
						<img src="/preview/profile-figure-v2.jpg" alt="김도위 프로필" width="1395" height="1832" />
					</figure>
					<div>
						<div class="overline">06 / ABOUT</div>
						<h2>김도위<br /><span class="role">가정의학과 전문의 · AI 교육자</span></h2>
						<p class="about-kicker">에스리본의원 홍대점 대표원장. 진료실에서 얻은 질문을 연구와 글로 남기고, 의료인이 AI를 스스로 쓰도록 가르칩니다.</p>
						<ul class="about-points">
							<li>한양대학교 의과대학 졸업, 가정의학과 전문의</li>
							<li>대한필러학회 AI 혁신 포럼 위원장 · 한국피부비만성형학회 AI 혁신 기획이사 · 한국AI리터러시협회 의료분과 전문위원</li>
							<li>D&amp;PS 월간 연재와 Doctor AI Academy로 현장 교육을 이어 갑니다</li>
						</ul>
						<ul class="portal-rows">
							<li>
								<a class="portal-row" href={ABOUT_HREF}>
									<span class="portal-title">철학과 약력 자세히 보기</span>
									<span aria-hidden="true">↗</span>
								</a>
							</li>
						</ul>
					</div>
				</section>
			</main>

			<footer class="footer">
				<b>S—REBORN</b>
				<span>© S-REBORN</span>
			</footer>
		</div>
		<BlogSearchScript
			searchIndex={searchIndex}
			supabaseUrl={import.meta.env.PUBLIC_SUPABASE_URL ?? ''}
			supabaseKey={import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? ''}
			contactEmail={CONTACT_EMAIL}
		/>
	</body>
</html>
