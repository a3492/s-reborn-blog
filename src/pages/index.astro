							<div class="overline">GO TO</div>
							<h2 id="shortcut-title">{copy.shortcutTitle}</h2>
						</div>
						<p class="section-intro">{copy.shortcutLead}</p>
					</div>
					<div class="portal-group">
						<h3>{copy.lectureGroup}</h3>
						<ul class="portal-rows">
							<li><a class="portal-row" href="/lectures/"><span class="portal-title">강연</span><span aria-hidden="true">↗</span></a></li>
							<li><a class="portal-row" href="/lecture-materials/"><span class="portal-title">강연·자료</span><span aria-hidden="true">↗</span></a></li>
							<li><a class="portal-row" href="/lecture-materials/kang-sehee/"><span class="portal-title">강세희 원장 강연</span><span aria-hidden="true">↗</span></a></li>
							<li><a class="portal-row" href="/lecture-materials/kim-dowi/"><span class="portal-title">김도위 원장 강연</span><span aria-hidden="true">↗</span></a></li>
							<li><a class="portal-row" href="/lecture-materials/archive/"><span class="portal-title">전체 강연 아카이브</span><span aria-hidden="true">↗</span></a></li>
							<li><a class="portal-row" href="/tools/lectures/2026-11-08-daemire/"><span class="portal-title">2026-11-08 대미레 강연 자료</span><span aria-hidden="true">↗</span></a></li>
						</ul>
					</div>
					<div class="portal-group">
						<h3>{copy.academyGroup}</h3>
