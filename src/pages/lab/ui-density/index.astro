---
/**
 * UI density laboratory: standalone A/B prototype.
 * Isolation: no shared Layout, global stylesheet, scripts, or navigation edits.
 * This file is on experiment/ui-density-ab-20261107, not on main.
 */
import { SITE_NAV } from '../../../data/site-nav';

const sections = SITE_NAV.map((item) => ({
  id: item.id,
  title: item.label,
  children: item.children.map((child) => ({
    label: child.label,
    href: child.href,
    pending: Boolean(child.pending),
    external: Boolean(child.external)
  }))
}));
const examples = [
  { label: 'CRM 데이터 첫 분석 · 5단계', href: '/tutorials/crm-first-analysis/', type: '실습', note: '목적 → 파일 → 분석 → 검산 → 의사결정' },
  { label: '실습 튜토리얼 모음', href: '/tutorials/', type: '튜토리얼', note: '자기주도형 단계별 학습' },
  { label: '11월 8일 대미레 강연 자료', href: '/tools/lectures/2026-11-08-daemire/', type: '강연', note: '파일과 복사 가능한 자료' },
  { label: '상담 데이터 아카이브', href: '/tools/consult-archive/', type: '자료', note: '예시 자료 읽기와 검산' },
  { label: '시술 데이터 아카이브', href: '/tools/procedure-archive/', type: '자료', note: '시술 자료 검색과 탐색' },
  { label: '병원 데이터 도구 목록', href: '/tools/', type: '도구', note: '경영 분석 및 실습 목록' },
  { label: 'AI 연구·글', href: '/blog/', type: '연구', note: '주제와 카테고리별 자료' },
  { label: '웹 강연 목록', href: '/lectures/', type: '강연', note: '공개된 강연 탐색' },
  { label: '문서·가이드', href: '/docs/', type: '문서', note: '기획과 사용 안내' },
  { label: 'Lab 허브', href: '/lab/', type: 'Lab', note: '별도 실험과 연결된 활동' },
];
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <title>UI Density A/B Lab · S-Reborn (isolated)</title>
    <style>
      :root{font-family:system-ui,-apple-system,'Pretendard','Malgun Gothic',sans-serif;color-scheme:light;--bg:#fff;--surface:#f6f8fa;--muted:#596579;--ink:#1f2937;--line:#d8dee6;--accent:#0969da;--row:34px;--space:12px;--side:250px}
      *{box-sizing:border-box}
      html{scroll-behavior:smooth}
      body{margin:0;background:var(--bg);color:var(--ink);font-size:14px;line-height:1.48}
      a{color:var(--accent);text-decoration:none}
      a:hover{text-decoration:underline}
      button{font:inherit;cursor:pointer}
      button:focus-visible,a:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
      .lab-header{display:flex;align-items:center;flex-wrap:wrap;gap:12px;padding:10px 18px;min-height:54px;border-bottom:1px solid var(--line);background:var(--surface)}
      .brand{font-size:16px;font-weight:760;letter-spacing:-.02em}
      .tag{padding:2px 7px;border-radius:4px;border:1px solid var(--line);font-size:11px;color:var(--muted)}
      .header-right{margin-left:auto;font-size:12px;color:var(--muted)}
      .toolbar{display:flex;align-items:center;flex-wrap:wrap;gap:12px;padding:10px 18px;border-bottom:1px solid var(--line)}
      .control{display:inline-flex;align-items:center;gap:5px}
      .control span{font-size:12px;color:var(--muted)}
      .segmented{display:inline-flex;gap:2px;padding:2px;background:var(--surface);border:1px solid var(--line);border-radius:7px}
      .segmented button{background:transparent;border:0;color:var(--muted);border-radius:5px;padding:5px 9px;min-height:30px}
      .segmented button[aria-pressed="true"]{background:var(--bg);color:var(--ink);font-weight:750;box-shadow:0 1px 2px #0001}
      .lede{padding:12px 18px;border-bottom:1px solid var(--line)}
      .lede h1{font-size:18px;line-height:1.3;margin:0 0 4px}
      .lede p{margin:0;color:var(--muted)}
      .layout{display:grid;grid-template-columns:var(--side) minmax(0,1fr);min-height:550px}
      .left{background:var(--surface);border-right:1px solid var(--line);padding:var(--space);min-width:0}
      .left-title{font-size:11px;letter-spacing:.075em;color:var(--muted);font-weight:800;margin:0 0 8px}
      .mobile-nav-toggle{display:none}
      .tree-group{margin:0 0 3px}
      .tree-group summary{list-style:none;display:flex;align-items:center;gap:5px;min-height:var(--row);padding:3px 6px;border-radius:5px;font-weight:700;cursor:pointer}
      .tree-group summary::-webkit-details-marker{display:none}
      .tree-group summary:before{content:'▸';font-size:12px;width:12px;color:var(--muted)}
      .tree-group[open] summary:before{content:'▾'}
      .tree-group summary:hover,.tree-item:hover{background:#e7eef8}
      .tree-list{padding-left:15px;margin:0 0 3px}
      .tree-item{display:block;padding:6px 8px;min-height:var(--row);color:var(--ink);border-radius:4px;overflow-wrap:anywhere}
      .tree-item:before{content:'⌁';margin-right:6px;color:#8993a1}
      .tree-item[aria-disabled="true"]{color:var(--muted)}
      .main{min-width:0;padding:var(--space) 18px 26px}
      .breadcrumb{font-size:12px;color:var(--muted);margin:0 0 8px}
      .main-heading{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin:0 0 8px}
      .main-heading h2{font-size:20px;line-height:1.25;margin:0}
      .summary{color:var(--muted);font-size:12px}
      .rows{border-top:1px solid var(--line)}
      .entry{display:grid;grid-template-columns:minmax(0,1fr) 75px;gap:12px;align-items:center;border-bottom:1px solid var(--line);padding:7px 5px;min-height:var(--row)}
      .entry-name{font-weight:650;overflow-wrap:anywhere}
      .entry-meta{color:var(--muted);font-size:12px;min-width:0}
      .entry-label{font-size:11px;text-align:right;color:var(--muted)}
      .help{margin:18px 0 0;border-top:1px solid var(--line);padding-top:12px}
      .help h3{font-size:14px;margin:0 0 5px}
      .help p{margin:0;color:var(--muted)}
      .notice{font-size:12px;color:var(--muted);margin-top:12px}
      .metric{font-variant-numeric:tabular-nums}
      [data-density="dense"]{--row:30px;--space:7px}
      [data-density="normal"]{--row:38px;--space:16px}
      [data-density="dense"] .entry{padding-top:4px;padding-bottom:4px}
      [data-density="dense"] .entry-meta{display:none}
      [data-density="normal"] .entry{padding-top:11px;padding-bottom:11px}
      [data-mode="wiki"] .layout{display:block;min-height:0}
      [data-mode="wiki"] .left{display:none}
      [data-mode="wiki"] .main{max-width:1100px;margin:0 auto}
      .wiki-index{display:none}
      [data-mode="wiki"] .wiki-index{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin:12px 0 18px}
      .wiki-index a{display:block;padding:8px 11px;background:var(--surface);border-bottom:1px solid var(--line);font-weight:650}
      .wiki-index a span{display:block;color:var(--muted);font-size:11px;font-weight:400}
      [data-mode="wiki"] .entry{grid-template-columns:minmax(0,1fr) 90px}
      [data-mode="wiki"] .entry-meta{display:none}
      .table-note{margin-top:20px;padding:10px 12px;background:var(--surface);border:1px solid var(--line);font-size:12px;color:var(--muted)}
      .table-note strong{color:var(--ink)}
      @media(max-width:800px){.layout{grid-template-columns:195px minmax(0,1fr)}.main{padding:10px 12px 20px}.left{padding:8px}.wiki-index{grid-template-columns:repeat(2,minmax(0,1fr))}}
      @media(max-width:560px){
        .lab-header,.toolbar,.lede{padding-left:12px;padding-right:12px}
        .header-right{margin-left:0;width:100%}
        .layout{display:block}
        .left{border-right:0;border-bottom:1px solid var(--line)}
        .left-title{display:none}
        .mobile-nav-toggle{display:block;width:100%;min-height:44px;padding:8px 10px;border:1px solid var(--line);border-radius:6px;background:var(--bg);color:var(--ink);text-align:left;font-weight:650}
        .left-groups{display:none;grid-template-columns:1fr 1fr;gap:3px 8px;margin-top:7px}
        .left.is-open .left-groups{display:grid}
        .tree-group{margin:0}
        .tree-group summary{min-height:44px}
        .tree-list{grid-column:1/-1}
        .tree-item{min-height:44px}
        .wiki-index{grid-template-columns:repeat(2,minmax(0,1fr))}
        .entry{min-height:44px}
      }
      @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
    </style>
  </head>
  <body data-mode="explorer" data-density="dense">
    <header class="lab-header">
      <span class="brand">S—REBORN / UI LAB</span>
      <span class="tag">브랜치 전용 · 운영 사이트 미반영</span>
      <span class="header-right">실제 메뉴 데이터 읽기 전용 · 실험 전용 스타일</span>
    </header>
    <section class="toolbar" aria-label="시안 설정">
      <div class="control"><span>화면 유형</span><div class="segmented" role="group" aria-label="레이아웃 비교"><button type="button" data-switch-mode="explorer" aria-pressed="true">A · GitHub형</button><button type="button" data-switch-mode="wiki" aria-pressed="false">B · Wiki형</button></div></div>
      <div class="control"><span>정보 밀도</span><div class="segmented" role="group" aria-label="밀도 비교"><button type="button" data-switch-density="dense" aria-pressed="true">압축</button><button type="button" data-switch-density="normal" aria-pressed="false">표준</button></div></div>
    </section>
    <section class="lede">
      <h1>한 화면에 더 많은 정보를, 더 적은 UI 장식으로</h1>
      <p>레이아웃을 비교하면서 링크를 찾는 데 필요한 클릭 수와 스크롤량을 확인합니다. 사용자 데이터는 수집하지 않습니다.</p>
    </section>
    <div class="layout">
      <aside class="left" aria-label="기존 메뉴 데이터의 트리형 미리보기">
        <p class="left-title">EXPLORER · 실제 메뉴</p>
        <button class="mobile-nav-toggle" type="button" aria-expanded="false" aria-controls="left-groups" data-mobile-nav-toggle>메뉴 펼치기 ▾</button>
        <nav class="left-groups" id="left-groups" aria-label="페이지 탐색">
          {sections.map((group, index) => (
            <details class="tree-group" open={index === 2 || index === 3}>
              <summary>{group.title}</summary>
              <div class="tree-list">
                {group.children.map((item) => (
                  <a class="tree-item" href={item.href} aria-disabled={item.pending ? 'true' : undefined} target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener noreferrer' : undefined}>{item.label}{item.external ? ' ↗' : ''}</a>
                ))}
              </div>
            </details>
          ))}
        </nav>
      </aside>
      <main class="main">
        <p class="breadcrumb">S—REBORN / 탐색 UI 실험 / 전체 콘텐츠</p>
        <div class="main-heading"><h2>콘텐츠 탐색</h2><span class="tag metric" id="item-count">{examples.length}개 항목</span></div>
        <p class="summary">실제 운영 페이지로 연결되는 대표 링크를 동일한 데이터로 비교합니다.</p>
        <nav class="wiki-index" aria-label="Wiki형 주제 바로가기">
          {sections.map((group) => (
            <a href={group.children.find((item) => !item.pending)?.href || '/'}>{group.title}<span>{group.children.length}개 메뉴</span></a>
          ))}
        </nav>
        <div class="rows" role="list" aria-label="대표 콘텐츠">
          {examples.map((entry) => (
            <div class="entry" role="listitem">
              <div><a class="entry-name" href={entry.href}>{entry.label}</a><div class="entry-meta">{entry.note}</div></div>
              <span class="entry-label">{entry.type}</span>
            </div>
          ))}
        </div>
        <section class="help">
          <h3>평가 과제</h3>
          <p>① CRM 5단계 실습 ② 11/8 강연 자료 ③ AI 연구 글 ④ 도구 목록을 찾으세요. 각 레이아웃의 첫 화면 노출 수와 조작 횟수를 비교합니다.</p>
        </section>
        <div class="table-note"><strong>품질 게이트</strong> · 모바일 390px 수평 스크롤 없음 · 키보드 포커스 확인 · 링크 정상 이동 · 원래 튜토리얼의 실행 기능 변경 없음. 이 시안은 메뉴·목록의 밀도만 검증합니다.</div>
        <p class="notice" id="state-note" aria-live="polite">A · GitHub형 / 압축 — 테스트 상태</p>
      </main>
    </div>
    <script>
      const mobileNavToggle = document.querySelector<HTMLButtonElement>('[data-mobile-nav-toggle]');
      mobileNavToggle?.addEventListener('click', () => {
        const side = mobileNavToggle.closest('.left');
        const expanded = side?.classList.toggle('is-open') || false;
        mobileNavToggle.setAttribute('aria-expanded', String(expanded));
        mobileNavToggle.textContent = expanded ? '메뉴 접기 ▴' : '메뉴 펼치기 ▾';
      });
      const buttons = document.querySelectorAll<HTMLButtonElement>('[data-switch-mode],[data-switch-density]');
      buttons.forEach((button) => {
        button.addEventListener('click', () => {
          const mode = button.dataset.switchMode;
          const density = button.dataset.switchDensity;
          if (mode) document.body.dataset.mode = mode;
          if (density) document.body.dataset.density = density;
          buttons.forEach((candidate) => {
            const isActive = candidate.dataset.switchMode
              ? candidate.dataset.switchMode === document.body.dataset.mode
              : candidate.dataset.switchDensity === document.body.dataset.density;
            candidate.setAttribute('aria-pressed', String(isActive));
          });
          const note = document.getElementById('state-note');
          if (note) note.textContent = (document.body.dataset.mode === 'wiki' ? 'B · Wiki형' : 'A · GitHub형') + ' / ' + (document.body.dataset.density === 'dense' ? '압축' : '표준') + ' — 테스트 상태';
        });
      });
    </script>
  </body>
</html>