---
import { getCollection } from 'astro:content';
import BlogSidebar from '../../../components/BlogSidebar.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import { CATEGORIES, MENU_GROUPS, SITE_DESCRIPTION } from '../../../consts';
import { buildCrumbs } from '../../../data/breadcrumbs';
import { cellOf, countTopics, taxonomyLinkForCell, topicOf } from '../../../data/taxonomy';
import Layout from '../../../layouts/Layout.astro';
import { getPublicSiteSettings } from '../../../lib/site-settings';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const siteSettings = await getPublicSiteSettings();
const counts = countTopics(posts);
const navigation = buildCrumbs(Astro.url.pathname, Astro.url.hash, true);
const total = Object.values(counts).reduce((sum, count) => sum + count, 0);
const legacy = {
	categories: Object.fromEntries(CATEGORIES.map(({ id, labelEn }) => [id, labelEn])),
	groups: Object.fromEntries(MENU_GROUPS.map(({ id, labelEn, cats }) => [id, { label: labelEn, cats }])),
};
---

<Layout title="AI LAB" description={siteSettings.siteDescription || SITE_DESCRIPTION} lang="en">
	<div class="blog-layout">
		{navigation && <BlogSidebar model={navigation} counts={counts} isEn />}
		<section class="blog-content" aria-labelledby="blog-content-title">
			<div class="blog-content-hd">
				<h1 class="blog-content-title" id="blog-content-title">AI LAB</h1><p lang="en">Article bodies are in Korean. English translations are not yet available. <a href="/en/technology/">Browse the English technology encyclopedia.</a></p>
				<span class="blog-content-count" id="blog-content-count">{total}</span>
			</div>
			<div class="blog-card-grid">
				{posts.map((post) => {
					const label = taxonomyLinkForCell(cellOf(post), true)?.label;
					const description = post.data.description_en ?? post.data.description;
					return (
						<a href={`/en/blog/${post.id}/`} class="blog-card" data-category={post.data.category ?? ''} hidden={!topicOf(post)}>
							<h2 class="blog-card-title">{post.data.title_en ?? post.data.title}</h2>
							<p class="blog-card-meta">
								{label && <span class="blog-card-cat">{label}</span>}
								{label && <span aria-hidden="true"> · </span>}
								<span class="blog-card-date"><FormattedDate date={post.data.date} /></span>
							</p>
							{description && <p class="blog-card-desc">{description}</p>}
						</a>
					);
				})}
			</div>
		</section>
	</div>
	<script type="application/json" id="legacy-blog-filters" is:inline set:html={JSON.stringify(legacy)}></script>
</Layout>

<script>
	const params = new URLSearchParams(location.search);
	const groupId = params.get('group');
	const categoryId = params.get('category');
	const legacy = JSON.parse(document.querySelector('#legacy-blog-filters')?.textContent ?? '{}');
	const group = groupId && Object.hasOwn(legacy.groups, groupId) ? legacy.groups[groupId] : undefined;
	const category = categoryId && Object.hasOwn(legacy.categories, categoryId) ? legacy.categories[categoryId] : undefined;
	if (group || category) {
		const categories = new Set<string>(group ? group.cats : [categoryId ?? '']);
		let count = 0;
		document.querySelectorAll<HTMLElement>('.blog-card').forEach((card) => {
			card.hidden = !categories.has(card.dataset.category ?? '');
			if (!card.hidden) count++;
		});
		document.querySelector('#blog-content-title')!.textContent = group?.label ?? category;
		document.querySelector('#blog-content-count')!.textContent = String(count);
	}
</script>

<style>
	.blog-content { min-width: 0; }
	.blog-card[hidden] { display: none; }
</style>
