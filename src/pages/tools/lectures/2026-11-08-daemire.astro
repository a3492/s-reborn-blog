	},
};

function withGuide(rows: GuideRow[], meta: Record<string, GuideMeta>, lastHref: string, lastLabel: string) {
	return rows.map((row, index) => {
		const next = rows[index + 1];
		return {
			...row,
			...meta[row.id],
			pasteWhere: meta[row.id]?.pasteWhere ?? 'ChatGPT 입력창에 붙여 넣습니다.',
			verify: meta[row.id]?.verify ?? '이 페이지의 표와 대조합니다.',
			nextHref: next ? `#${next.id}` : lastHref,
			nextLabel: next ? `다음 · ${next.title}` : lastLabel,
		};
	});
}

const lecture1Guide = withGuide(lecture1Rows, lecture1Meta, '#ops', '강연2 시작');
const lecture2Guide = withGuide(lecture2Rows, lecture2Meta, '#bep', '계산기로 돌아가기');

