시술 믹스, 할인·환불, 인건비 배부, 장비 감가상각, 세금, 예약 취소, 가동률 등이 결과에 어떤 영향을 줄 수 있는지 설명해 주세요.
현재 모델이 단순화한 예제라는 점과 실제 의사결정 전에 확인할 자료를 체크리스트로 만들어 주세요.`,
		success: '단일 시술·단일 단가·일정한 변동원가를 가정한 계산이며, 실제 손익과 다를 수 있다고 한계를 적습니다.',
		stuck: '결과를 확정 순이익처럼 말하면 “이 값은 단순 손익분기 추정치이며 순이익이 아님을 명시해 다시 작성해 주세요”라고 요청합니다.',
	},
];

function fileHref(name: string): string {
	return `/downloads/daemire-1108/${encodeURIComponent(name)}`;
}

function fileSize(name: string): string {
	const bytes = fs.statSync(path.join(downloadDir, name)).size;
	if (bytes < 1024) return `${bytes} B`;
	return `${(bytes / 1024).toFixed(1)} KB`;
}
