---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../../../layouts/Layout.astro';

const downloadDir = path.join(process.cwd(), 'public/downloads/daemire-1108');

type DownloadFile = {
	name: string;
	format: string;
	slides: string;
	note: string;
};

type GuideRow = {
	id: string;
	slide: string;
	file: string;
	ai: string;
	prompt: string;
	check: string;
};

const lecture1Files: DownloadFile[] = [
	{
		name: 'DML_A-H_8대페인포인트_강연순서_1페이지_인덱스_v1.md',
		format: 'MD',
		slides: '개념 색인',
		note: 'A–H 1페이지 색인. 읽기용 본문은 아래 기존 페이지입니다. 환자 사례는 없습니다.',
	},
	{
		name: 'L1_CRM_합성데이터_v1.0.xlsx',
		format: 'XLSX',
		slides: '가이드 03·05·07·11·13·15',
		note: '방문 200행. 한 행은 방문 1건.',
	},
	{
		name: 'L1_문의_합성데이터_v1.0.csv',
		format: 'CSV',
		slides: '가이드 09·13·15',
		note: '문의 96행. 한 행은 문의 1건. CRM 파일과 공통 ID 없음.',
	},
	{
		name: 'L1_프롬프트와_슬라이드별_실습가이드.md',
		format: 'MD',
		slides: '가이드 03–15',
		note: '복붙 프롬프트와 확인할 점. 슬라이드 번호는 권장 매핑입니다.',
	},
	{
		name: 'L1_지표정의_결정카드_템플릿.md',
		format: 'MD',
		slides: '가이드 15',
		note: '지표 정의 카드와 경영 결정 카드. 빈칸에 적어 씁니다.',
	},
	{
		name: 'L1_검산과_데이터품질_체크리스트.md',
		format: 'MD',
		slides: '집계·결합·검산',
		note: '행 수, 합계, 조인, AI 결과 확인 목록.',
	},
];

const lecture2Files: DownloadFile[] = [
	{
		name: 'L2_원가_BEP_시연입력_v1.0.xlsx',
		format: 'XLSX',
		slides: '강연2 7–9',
		note: '시나리오별 판매단가, 건당 변동원가, 월 고정비, 예상 월시술건수.',
	},
	{
		name: 'L2_원가_BEP_시연입력.csv',
