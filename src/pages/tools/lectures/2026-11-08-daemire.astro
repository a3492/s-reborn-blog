      "L2_원가_BEP_독립검산_v4.xlsx"
    ],
    "review": "복습 심화: 월 고정비 0원인 경우는 별도 예외 규칙을 명시해야 합니다. 계산기 수치만으로 실제 손익·현금흐름·수요를 확정하지 마세요."
  },
  {
    "id": "l2-6",
    "title": "내 병원의 다음 도구 정하기",
    "time": "25:00–28:00",
    "slide": "PPT 10–11장",
    "show": "입지·채용·직원 교육·장비·재고 등 개원 경영 영역에서 다음으로 해결할 문제 한 가지를 선택합니다.",
    "steps": [
      "문제가 있는 경영 분야를 하나만 고릅니다.",
      "문제·필요 입력·원하는 결과·독립 검증 방법을 한 문장씩 적습니다.",
      "완성된 도구를 곧바로 실무에 적용하지 말고 사람이 검증할 조건을 정합니다."
    ],
    "prompt": "나는 개원을 준비하는 의사입니다. 모든 병원 경영 문제를 한 번에 해결하려 하지 않고, 우선 하나의 작은 도구를 기획하겠습니다.\n다음 분야에서 하나를 선택할 수 있도록 도와 주세요: 진료 전략, 입지·부동산, 재무·자금, 인테리어·장비, 진료 안전, 채용·교육·복지, 마케팅·환자 경험, 운영·재고·성과.\n각 선택지에 대해 해결하려는 의사결정 한 문장, 필요한 입력, 얻고 싶은 출력, 선행조건, 검증 방법을 간단히 보여 주세요.\n내가 하나를 선택하면 그 도구의 최소 기능을 설계하되 법률·의료·재무 판단은 최종 승인 항목으로 분리해 주세요.\n실제 환자·직원 개인정보나 비공개 계약 원문은 요구하지 마세요.",
    "success": "최소 한 가지 문제에 대해 ‘지금 내릴 결정 → 입력 → 출력 → 검증 → 다음 행동’이 정리됩니다. 계산기와 다른 종류의 도구도 시작할 수 있습니다.",
    "stuck": "너무 범위가 넓다면 ‘개원 후보지 2곳 비교’ 또는 ‘신규 직원 첫날 업무 체크리스트’처럼 작고 검증 가능한 한 가지 과제로 줄입니다.",
    "resources": [
      "L2_내병원_작은도구_기획시트.md"
    ],
    "review": "복습: AI가 만든 체크리스트는 실제 인허가·의료광고·근로기준·의료기기 관련 법령 검토와 책임자 승인을 대체하지 않습니다."
  }
];

function fileHref(name: string): string {
	return `/downloads/daemire-1108/${encodeURIComponent(name)}`;
}

function fileSize(name: string): string {
	const bytes = fs.statSync(path.join(downloadDir, name)).size;
	if (bytes < 1024) return `${bytes} B`;
	return `${(bytes / 1024).toFixed(1)} KB`;
}
