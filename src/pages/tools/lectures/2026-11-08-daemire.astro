---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../../../layouts/Layout.astro';

const downloadDir = path.join(process.cwd(), 'public/downloads/daemire-1108');

type DownloadFile = {
	name: string;
	note: string;
};

type GuideRow = {
	id: string;
	title: string;
	show: string;
	steps: string[];
	prompt: string;
	success: string;
	stuck: string;
};

const startGuide = '00_시작하기_자료사용가이드.md';

const downloads: DownloadFile[] = [
	{
		name: startGuide,
		note: '처음 여는 안내입니다. 파일 이름, 번호, 따라가는 순서가 적혀 있습니다.',
	},
	{
		name: '01_고객정보_수집경로별_원본예시와_자동정리.md',
		note: '방문·문의 파일을 열기 전에 읽습니다. 대화, 알림, 메모가 한 표로 모이는 과정입니다.',
	},
	{
		name: '2026년10월_방문시술매출_CRM.xlsx',
		note: '2026년 10월 방문 200건. 한 행은 방문 1건입니다.',
	},
	{
		name: '2026년10월_상담문의_목록.csv',
		note: '2026년 10월 상담 문의 96건입니다.',
	},
	{
		name: 'L1_프롬프트와_슬라이드별_실습가이드_v3.md',
		note: '강연1에서 붙여 넣는 문장과 슬라이드별 순서입니다.',
	},
	{
		name: 'L1_지표정의_결정카드_템플릿.md',
		note: '재방문율처럼 숫자를 세기 전에 기준을 적는 카드입니다.',
	},
	{
		name: 'L1_검산과_데이터품질_체크리스트.md',
		note: '합계, 빠진 값, 중복을 원본과 대조할 때 엽니다.',
	},
	{
		name: 'L2_원가_BEP_시연입력_v1.0_v4.xlsx',
		note: '강연2 계산기 입력. 기준 단가 200,000원, 변동원가 50,000원, 월 고정비 15,000,000원.',
	},
	{
		name: 'L2_원가_BEP_시연입력_v4.csv',
		note: '같은 입력의 CSV. 엑셀을 열 수 없을 때 붙입니다.',
	},
	{
		name: 'L2_원가_BEP_독립검산_v4.xlsx',
		note: 'AI 결과와 따로 맞춰 보는 검산표입니다. 단가 인하는 변동원가 50,000원을 유지합니다.',
	},
	{
		name: 'L2_AI도구_제작프롬프트와_검증테스트_v3.md',
		note: '강연2에서 붙여 넣는 문장과 확인 숫자입니다.',
	},
	{
		name: 'L2_내병원_작은도구_기획시트.md',
		note: '내 병원 고정비와 시술별 원가를 적는 시트입니다.',
	},
	{
		name: 'DML_A-H_8대페인포인트_강연순서_1페이지_인덱스_v1.md',
		note: 'A–H 한 장 색인. 읽어 보는 본문은 아래 기존 페이지입니다.',
	},
];

if (downloads.length !== 13) {
	throw new Error(`대미레 다운로드는 13개여야 합니다. 현재 ${downloads.length}개`);
}
for (const file of downloads) {
	fs.accessSync(path.join(downloadDir, file.name));
}

const lecture1Rows: GuideRow[] = [
	{
		id: 'l1-1',
		title: '1. 오늘 할 일',
		show: 'AI에게 파일을 첨부하고 “먼저 표 구조부터 설명하라”고 요청합니다. 열의 뜻과 한 행의 단위를 먼저 확인합니다.',
		steps: [
			'`2026년10월_방문시술매출_CRM.xlsx`를 PC에 다운로드한다.',
			'ChatGPT 대화를 열고 입력창 옆 파일 첨부 버튼을 누른다.',
			'파일을 선택한 뒤 아래 문장을 붙여넣고 전송한다.',
		],
		prompt: `첨부한 엑셀은 100% 데이터입니다.
분석은 아직 하지 마세요.
먼저 시트 이름, 데이터 행 수, 열 제목을 확인해 주세요.
각 열이 무엇을 뜻하는지 쉬운 한국어로 설명하고, 한 행이 무엇을 의미하는지 데이터만으로 확인할 수 있는지 알려 주세요.
확인할 수 없는 내용은 추측하지 마세요.`,
		success:
			'“방문시술매출 시트 200행. 방문일·시술·금액·재방문·유입채널 열이 있습니다. 한 행이 방문 1건인지 환자 1명인지는 중복 환자 식별 기준을 추가 확인해야 합니다.”처럼 구조와 한계를 함께 말합니다.',
		stuck: '파일이 첨부되지 않으면 파일 첨부 버튼을 다시 눌러 파일을 선택합니다. AI가 환자 수라고 단정하면 “행 수와 환자 수를 구분해 주세요”라고 추가 입력합니다.',
	},
	{
		id: 'l1-2',
		title: '2. 문의 유형',
		show: 'CSV를 첨부해 문의 유형별 건수를 세고, 합계가 전체 96건인지 확인합니다.',
		steps: [
			'`2026년10월_상담문의_목록.csv`를 다운로드한다.',
			'새 대화 또는 같은 대화에 파일을 첨부한다.',
			'아래 프롬프트를 붙여넣는다.',
		],
		prompt: `첨부한 CSV는 상담 문의 96건입니다.
문의 유형별 건수를 세어 표로 보여 주세요.
유형별 건수의 합이 96건인지 확인하고, 각 유형의 비율도 계산해 주세요.
예상 분포는 48건, 12건, 8건, 28건입니다.
실제 집계가 예상과 다르면 숫자를 억지로 맞추지 말고 차이를 알려 주세요.`,
		success: '4개 유형이 각각 48·12·8·28건이고 합계가 96건입니다. 비율은 각각 50.0%, 12.5%, 약 8.3%, 약 29.2%입니다.',
		stuck: 'AI가 분류명을 바꾸면 “원본 CSV의 분류명을 그대로 사용하세요”라고 합니다. 합계가 96이 아니면 중복 행이나 빈 행이 있는지 확인해 달라고 요청합니다.',
	},
	{
		id: 'l1-3',
		title: '3. 데이터 품질',
		show: '분석 전에 데이터가 믿을 만한지 확인합니다. 중복은 같은 기록이 두 번 들어간 것이고, 누락은 있어야 할 값이 비어 있는 것입니다.',
		steps: [
			'CRM 엑셀 파일을 첨부한다.',
			'아래 프롬프트를 입력한다.',
			'AI가 제시한 행 번호와 열 이름을 원본 엑셀에서 확인한다.',
		],
		prompt: `첨부한 CRM 데이터의 품질을 점검해 주세요.
1. 완전히 똑같은 행이 있는지
2. 중요한 열에 빈칸이 있는지
3. 금액이 0원 또는 음수인 행이 있는지
4. 날짜 형식이 다른 행이 있는지
5. 재방문 값이나 유입채널처럼 정해진 선택지와 다른 값이 있는지
항목별 발견 건수와 해당 행 번호를 표로 보여 주세요.
문제가 없으면 없다고 말하고, 임의로 데이터를 수정하지 마세요.`,
		success: '“금액 빈칸 2건, 날짜 형식 확인 필요 1건”처럼 건수와 위치가 표시됩니다. 문제가 없는 항목은 0건입니다.',
		stuck: '행 번호가 실제 엑셀과 다르면 제목 행 포함 여부를 확인합니다. “첫 번째 제목 행을 제외한 데이터 기준 행 번호도 함께 표시해 주세요”라고 요청합니다.',
	},
	{
		id: 'l1-4',
		title: '4. 지표 정의',
		show: '같은 이름의 지표도 계산 방법이 다를 수 있습니다. 재방문율은 환자 수 기준인지 방문 건수 기준인지에 따라 결과가 달라집니다.',
		steps: [
			'`L1_지표정의_결정카드_템플릿.md`를 연다.',
			'오늘 계산할 지표 하나를 고른다. 예: 재방문율.',
			'아래 문장으로 분모와 분자를 먼저 정리한다.',
		],
		prompt: `CRM 데이터에서 재방문율을 계산하고 싶습니다.
계산하기 전에 다음을 쉬운 말로 정리해 주세요.
- 분자: 비율에서 위쪽에 들어가는 숫자
- 분모: 비율에서 아래쪽에 들어가는 전체 숫자
- 어떤 사람 또는 방문을 세는지
- 어느 기간을 기준으로 하는지
데이터에 필요한 정보가 없으면 계산하지 말고 부족한 정보를 알려 주세요.`,
		success:
			'“재방문 환자 수 ÷ 첫 방문 환자 수”처럼 계산 기준이 문장으로 정리되고, 기간이 없으면 기간을 정해야 한다고 알려 줍니다.',
		stuck: '분모가 모호하면 결과 숫자를 요구하지 않습니다. 먼저 병원에서 사용할 정의를 결정카드에 기록합니다.',
	},
	{
		id: 'l1-5',
		title: '5. 유입채널',
		show: '인스타그램, 소개, 검색처럼 유입 경로별로 기록을 나눕니다. 건수가 많다는 사실만으로 매출 기여가 높다고 결론 내리지 않습니다.',
		steps: [
			'CRM 파일을 첨부한다.',
			'유입채널 열이 있는지 확인한다.',
			'아래 문장으로 채널별 건수와 금액을 따로 집계한다.',
		],
		prompt: `CRM 데이터에서 유입채널별로 다음 숫자를 계산해 주세요.
1. 기록 건수
2. 결제금액 합계
3. 기록 1건당 평균 결제금액
표로 정리하고 전체 합계와 맞는지 확인해 주세요.
유입채널이 비어 있는 행은 별도 항목으로 표시하세요.
이 결과만으로 광고 효과가 좋다거나 나쁘다고 단정하지 마세요.`,
		success: '채널별 건수·결제금액 합계·평균 금액이 각각 구분됩니다. 전체 합계와 채널별 합계가 일치합니다.',
		stuck: 'AI가 문의 수와 방문 수를 섞으면 “이 파일의 한 행이 의미하는 단위부터 다시 확인해 주세요”라고 합니다.',
	},
	{
		id: 'l1-6',
		title: '6. 문의에서 방문으로',
		show: '두 파일을 합치려면 같은 의미의 연결 번호가 있어야 합니다. 이름이 비슷하다고 같은 사람으로 보지 않습니다.',
		steps: [
			'CRM 엑셀과 문의 CSV를 같은 대화에 모두 첨부한다.',
			'두 파일의 ID 열을 확인한다.',
			'연결문의번호와 문의관리번호를 비교한다. 확인된 연결 30건 외에는 억지로 채우지 않는다.',
		],
		prompt: `첨부한 CRM 파일과 문의 파일을 비교해 주세요.
CRM 연결문의번호와 문의파일 문의관리번호를 서로 비교해 주세요. 연결된 행의 고객관리번호도 교차 검증하고, 미연결 행은 그대로 남겨 주세요.
CRM의 연결문의번호와 문의 CSV의 문의관리번호가 동일하고, 고객관리번호도 일치하는지 확인하세요. 일치하지 않으면 연결하지 마세요.
연결 가능한 경우에만 연결 전 행 수와 연결 후 행 수를 비교하고, 중복으로 행이 늘어나는지 점검해 주세요.`,
		success:
			'“연결문의번호로 확인된 30건의 연결은 검토할 수 있지만, 미확인 기록의 전환 여부는 판단할 수 없습니다”처럼 근거를 말합니다.',
		stuck: 'AI가 이름·날짜를 조합해 연결하면 멈춥니다. 병원에서는 승인된 절차로 연결 번호를 만든 뒤에 봅니다.',
	},
	{
		id: 'l1-7',
		title: '7. 숫자에서 질문',
		show: '데이터는 답을 대신 정해 주지 않습니다. 표에서 본 사실과 그럴듯한 설명을 구분합니다.',
		steps: [
			'앞 단계에서 확인한 채널별 결과를 준비한다.',
			'아래 문장을 입력한다.',
			'사실과 추측이 분리되어 있는지 읽는다.',
		],
		prompt: `지금까지 계산한 결과를 바탕으로 관찰된 사실 3개를 적어 주세요.
각 사실마다 가능한 설명을 2개씩 제시하되, 설명은 아직 가설이라고 표시해 주세요.
가설을 확인하려면 어떤 추가 데이터가 필요한지 적어 주세요.
데이터만으로 알 수 없는 원인이나 인과관계를 사실처럼 말하지 마세요.`,
		success:
			'“채널 A 기록 건수가 가장 많다”는 사실과 “광고비가 효율적일 수 있다”는 가설이 구분됩니다. 광고비나 신규 환자 여부가 없으면 추가 자료가 필요하다고 말합니다.',
		stuck: '답이 두루뭉술하면 “각 항목을 실제 병원에서 확인할 수 있는 숫자와 자료명으로 구체화해 주세요”라고 요청합니다.',
	},
	{
		id: 'l1-8',
		title: '8. 경영 의사결정',
		show: '결과를 곧바로 큰 변경으로 잇지 않습니다. 작게 시험하고 전후 숫자를 적습니다.',
		steps: [
			'관심 있는 문제 하나를 고른다.',
			'아래 문장을 입력한다.',
			'실행 전 기준 숫자와 실행 후 확인할 숫자를 기록한다.',
		],
		prompt: `데이터에서 확인한 사실을 바탕으로 2주 안에 시험할 수 있는 작은 개선 실험 3개를 제안해 주세요.
각 실험마다 대상, 바꿀 행동, 기간, 시작 전 숫자, 종료 후 숫자, 성공 기준, 부작용 점검 항목을 적어 주세요.
실제 데이터로 효과가 확인되기 전에는 매출 상승을 보장한다고 표현하지 마세요.`,
		success: '“문의 응답 시간을 기록하고 2주 동안 응답 절차를 바꾼 뒤 예약 전환을 비교”처럼 실행과 측정이 한 세트로 나옵니다.',
		stuck: '실험이 너무 크면 “직원 1명 또는 문의 유형 1개부터 시험하는 최소 규모로 줄여 주세요”라고 요청합니다.',
	},
	{
		id: 'l1-9',
		title: '9. 결과 검산',
		show: '합계, 행 수, 중복, 누락을 원본 파일과 대조합니다. 숫자를 베끼기 전에 확인합니다.',
		steps: [
			'`L1_검산과_데이터품질_체크리스트.md`를 연다.',
			'AI가 계산한 합계와 원본 엑셀 합계를 비교한다.',
