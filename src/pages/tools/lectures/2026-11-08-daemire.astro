							<div class="ops-step-footer">
								<button type="button" class="ops-secondary" data-ops-jump={index - 1} disabled={index === 0}>이전 단계</button>
								<span>{index + 1} / {lecture2Rows.length}</span>
								<button type="button" data-ops-jump={index + 1} disabled={index === lecture2Rows.length - 1}>다음 단계</button>
							</div>
						</section>
					))}
				</div>
