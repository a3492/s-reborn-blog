</Layout>

<script>
	const root = document.querySelector('[data-lecture]');
	const status = document.querySelector('[data-copy-status]');
	const crm = document.querySelector('#tab-crm');
	const ops = document.querySelector('#tab-ops');
	const opsPanel = document.querySelector('.panel-ops');
	const stepCards = Array.from(opsPanel?.querySelectorAll('[data-ops-card]') ?? []);
	const stepNav = Array.from(opsPanel?.querySelectorAll('.ops-step-nav [data-ops-jump]') ?? []);
	function activateOpsStep(index: number) {
		if (!Number.isInteger(index) || index < 0 || index >= stepCards.length) return;
		stepCards.forEach((card, i) => {
			if (card instanceof HTMLElement) card.hidden = i !== index;
		});
		stepNav.forEach((button, i) => {
			button.setAttribute('aria-pressed', i === index ? 'true' : 'false');
		});
		const textNode = opsPanel?.querySelector('[data-ops-progress]');
		const title = stepNav[index]?.textContent?.trim() ?? '';
		if (textNode) textNode.textContent = (index + 1) + ' / ' + stepCards.length + ' · ' + title.replace(/^\\d+/, '').trim();
		opsPanel?.querySelector('.ops-progress')?.scrollIntoView({behavior:'smooth',block:'start'});
	}


	function applyHash() {
		if (!(crm instanceof HTMLInputElement) || !(ops instanceof HTMLInputElement)) return;
		if (location.hash === '#ops' || location.hash === '#lecture-2') ops.checked = true;
		if (location.hash === '#crm' || location.hash === '#lecture-1') crm.checked = true;
	}

	applyHash();
	window.addEventListener('hashchange', applyHash);
	crm?.addEventListener('change', () => {
		if (crm instanceof HTMLInputElement && crm.checked) history.replaceState(null, '', '#crm');
	});
	ops?.addEventListener('change', () => {
		if (ops instanceof HTMLInputElement && ops.checked) history.replaceState(null, '', '#ops');
	});

	root?.addEventListener('click', async (event) => {
		const clicked = event.target;
		if (!(clicked instanceof Element)) return;
		const target = clicked.closest('button');
		if (!(target instanceof HTMLButtonElement) || !root?.contains(target)) return;
		if (target.dataset.opsJump !== undefined) {
			activateOpsStep(Number(target.dataset.opsJump));
			return;
		}
		if (target.dataset.opsMode !== undefined) {
			const reviewing = opsPanel?.classList.toggle('ops-review') ?? false;
			target.setAttribute('aria-pressed', reviewing ? 'true' : 'false');
			target.textContent = reviewing ? '현장 모드로 돌아가기' : '복습 모드 켜기';
			return;
		}
		const code = target.dataset.copy;
		if (!code) return;
		const node = document.getElementById(`copy-${code}`);
		const text = node?.textContent?.trim() ?? '';
		const label = target.dataset.label ?? '문장 복사';
		try {
			if (navigator.clipboard?.writeText) {
				await navigator.clipboard.writeText(text);
			} else {
				throw new Error('clipboard unavailable');
			}
		} catch {
			const area = document.createElement('textarea');
			area.value = text;
			area.setAttribute('readonly', '');
			area.style.position = 'fixed';
			area.style.left = '-9999px';
			document.body.appendChild(area);
			area.select();
			document.execCommand('copy');
			area.remove();
		}
		target.textContent = '복사됨';
		if (status) status.textContent = '문장을 복사했습니다.';
		window.setTimeout(() => {
			target.textContent = label;
		}, 1800);
	});
</script>

