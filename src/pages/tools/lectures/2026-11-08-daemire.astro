<script>
	const root = document.querySelector('[data-lecture]');
	const status = document.querySelector('[data-copy-status]');
	const crm = document.querySelector('#tab-crm');
	const ops = document.querySelector('#tab-ops');

	function applyHash() {
		if (!(crm instanceof HTMLInputElement) || !(ops instanceof HTMLInputElement)) return;
		const hash = location.hash;
		if (hash === '#ops' || hash === '#lecture-2' || hash === '#bep' || hash.startsWith('#l2-')) ops.checked = true;
		if (hash === '#crm' || hash === '#lecture-1' || hash.startsWith('#l1-')) crm.checked = true;
		const id = hash.slice(1);
		const node = id ? document.getElementById(id) : null;
		if (node) requestAnimationFrame(() => node.scrollIntoView({ block: 'start' }));
	}

	applyHash();
	window.addEventListener('hashchange', applyHash);
	crm?.addEventListener('change', () => {
		if (crm instanceof HTMLInputElement && crm.checked) history.replaceState(null, '', '#crm');
	});
	ops?.addEventListener('change', () => {
		if (ops instanceof HTMLInputElement && ops.checked) history.replaceState(null, '', '#ops');
	});

	root?.addEventListener('click', async (event) => {
		const target = event.target;
		if (!(target instanceof HTMLButtonElement)) return;
		const code = target.dataset.copy;
		if (!code) return;
		const node = document.getElementById(`copy-${code}`);
		const text = node?.textContent?.trim() ?? '';
		const label = target.dataset.label ?? '문장 복사';
		try {
			if (navigator.clipboard?.writeText) {
				await navigator.clipboard.writeText(text);
			} else {
				throw new Error('clipboard unavailable');
			}
		} catch {
			const area = document.createElement('textarea');
			area.value = text;
			area.setAttribute('readonly', '');
			area.style.position = 'fixed';
			area.style.left = '-9999px';
			document.body.appendChild(area);
			area.select();
			document.execCommand('copy');
			area.remove();
		}
		target.textContent = '복사됨';
		if (status) status.textContent = '문장을 복사했습니다.';
		window.setTimeout(() => {
			target.textContent = label;
		}, 1800);
	});
</script>

