---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { TOOL_TOPICS, topicLabel } from '../../lib/tool-archives';

const archives = (await getCollection('toolArchives', ({ data }) => !data.draft)).sort(
	(a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title, 'ko'),
);
---

<Layout
	title="강연·자료"
	description="이전 강연과 2026-11-08 대미레에서 따라가는 자료입니다."
>
	<div class="tools-hub">
		<header class="tools-head">
			<p class="tools-kicker">S-reborn MD AI HUB</p>
			<h1>강연·자료</h1>
			<p class="tools-lead">
				이전 강연은 슬라이드를 넘기면 됩니다. 2026-11-08 대미레는 아래 순서대로 한 화면에서 따라갑니다.
			</p>
		</header>

		<section class="tools-topic" aria-labelledby="topic-earlier">
			<div class="tools-topic-head">
				<h2 id="topic-earlier">이전 강연</h2>
				<p>브라우저에서 슬라이드를 넘깁니다.</p>
			</div>
			<ul class="tools-list">
				<li>
					<a class="tools-card" href="/lectures/koat-ai-2026/">
						<span class="tools-card-kicker">KOAT 2026</span>
						<strong>슬라이드 보기</strong>
						<span>방향키로 넘기고, F로 전체화면을 켭니다.</span>
					</a>
				</li>
			</ul>
		</section>

		<section class="tools-topic" aria-labelledby="topic-lectures">
			<div class="tools-topic-head">
				<h2 id="topic-lectures">2026-11-08 대미레</h2>
				<p>오늘 순서입니다. 각 화면을 열면 할 일이 먼저 보입니다.</p>
			</div>
			<ul class="tools-list">
				<li>
					<a class="tools-card" href="/tools/lectures/2026-11-08-daemire/">
						<span class="tools-card-kicker">1</span>
						<strong>오늘 따라가기</strong>
						<span>다섯 칸이 이 페이지에 펼쳐져 있습니다. 강연1과 강연2 문장도 여기 있습니다.</span>
					</a>
				</li>
				<li>
					<a class="tools-card" href="/tools/hospital-data-pain-points/">
						<span class="tools-card-kicker">2</span>
						<strong>페인포인트 B·C·H</strong>
						<span>오늘 보여주는 글은 추출, 채널, 결정입니다.</span>
					</a>
				</li>
				<li>
					<a class="tools-card" href="/tools/consult-archive/">
						<span class="tools-card-kicker">3</span>
						<strong>상담 기록 읽기</strong>
						<span>김민지 10건으로, 짧은 메모가 한 고객의 조각인 이유를 봅니다.</span>
					</a>
				</li>
				<li>
					<a class="tools-card" href="/tools/procedure-archive/">
						<span class="tools-card-kicker">4</span>
						<strong>시술 기록 한 건</strong>
						<span>울쎄라 문의 한 건으로 경과 요약을 붙여 넣습니다.</span>
					</a>
				</li>
			</ul>
		</section>

		{
			TOOL_TOPICS.map((topic) => {
				const entries = archives.filter(
					(entry) => entry.data.topic === topic.id && entry.id !== 'hospital-data-pain-points',
				);
				if (entries.length === 0 && topic.id === 'hospital-data') return null;
				return (
					<section class="tools-topic" aria-labelledby={`topic-${topic.id}`}>
						<div class="tools-topic-head">
							<h2 id={`topic-${topic.id}`}>{topic.label}</h2>
							<p>{topic.note}</p>
						</div>
						{entries.length === 0 ? (
							<p class="tools-empty">아직 올라온 자료가 없습니다.</p>
						) : (
							<ul class="tools-list">
								{entries.map((entry) => (
									<li>
										<a class="tools-card" href={`/tools/${entry.id}/`}>
											<span class="tools-card-kicker">{topicLabel(entry.data.topic)}</span>
											<strong>{entry.data.title}</strong>
											<span>{entry.data.summary}</span>
											<em>{entry.data.items.length}개 항목 · 복사 · .md / .txt</em>
										</a>
									</li>
								))}
							</ul>
						)}
					</section>
				);
			})
		}
	</div>
</Layout>

<style>
	.tools-hub {
		padding: 2.5rem 0 4rem;
		max-width: 46rem;
	}
	.tools-kicker {
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		font-weight: 700;
		color: var(--pink);
	}
	.tools-head h1 {
		font-family: var(--display);
		font-size: clamp(1.8rem, 4vw, 2.4rem);
		letter-spacing: -0.03em;
		margin: 0.35rem 0 0.6rem;
	}
	.tools-lead,
	.tools-topic-head p,
	.tools-empty {
		color: var(--t2);
		line-height: 1.6;
	}
	.tools-topic {
		margin-top: 2rem;
	}
	.tools-topic-head h2 {
		font-family: var(--display);
		font-size: 1.25rem;
		margin: 0;
	}
	.tools-topic-head p,
	.tools-empty {
		margin: 0.35rem 0 0;
	}
	.tools-list {
		list-style: none;
		padding: 0;
		margin: 0.9rem 0 0;
		display: grid;
		gap: 0.8rem;
	}
	.tools-card {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding: 1rem 1.1rem;
		border: 1px solid var(--rule);
		border-radius: 14px;
		background: var(--bg2);
		text-decoration: none;
		color: inherit;
	}
	.tools-card:hover {
		border-color: var(--pink);
	}
	.tools-card-kicker,
	.tools-card em {
		font-style: normal;
		font-size: 0.78rem;
		color: var(--t3);
	}
	.tools-card strong {
		font-family: var(--display);
		font-size: 1.05rem;
	}
	.tools-card span:last-of-type {
		color: var(--t2);
		line-height: 1.55;
	}
</style>
