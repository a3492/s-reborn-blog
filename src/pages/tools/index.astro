---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { TOOL_TOPICS, topicLabel } from '../../lib/tool-archives';

const archives = (await getCollection('toolArchives', ({ data }) => !data.draft)).sort(
	(a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title, 'ko'),
);
---

<Layout
	title="강연·자료"
	description="이전 강연과 2026-11-08 대미레에서 따라가는 자료입니다."
>
	<div class="tools-hub">
		<header class="tools-head">
			<p class="tools-kicker">S-reborn MD AI HUB</p>
			<h1>강연·자료</h1>
			<p class="tools-lead">
				이전 강연은 슬라이드입니다. 대미레의 학습 단계는 여섯 단계이고, 그 아래 자료는 단계가 아니라 실습에 쓰는 기록입니다.
			</p>
		</header>

		<section class="tools-topic" aria-labelledby="topic-earlier">
			<div class="tools-topic-head">
				<h2 id="topic-earlier">이전 강연</h2>
				<p>브라우저에서 슬라이드를 넘깁니다.</p>
			</div>
			<ul class="tools-list">
				<li>
					<a class="tools-card" href="/lectures/koat-ai-2026/">
						<span class="tools-card-kicker">KOAT 2026</span>
						<strong>슬라이드 보기</strong>
						<span>방향키로 넘기고, F로 전체화면을 켭니다.</span>
					</a>
				</li>
			</ul>
		</section>

		<section class="tools-topic" aria-labelledby="topic-stages">
			<div class="tools-topic-head">
				<h2 id="topic-stages">학습 단계</h2>
				<p>문제 발견, 문제 검증, 해결책 설계, MVP 실험, 결과 검증, 현장 적용.</p>
			</div>
			<ul class="tools-list">
				<li>
					<a class="tools-card" href="/tools/lectures/2026-11-08-daemire/#discover">
						<span class="tools-card-kicker">대미레</span>
						<strong>여섯 단계</strong>
						<span>각 단계에 복사할 것, 붙여 넣을 곳, 기대하는 결과, 검증 방법이 적혀 있습니다.</span>
					</a>
				</li>
			</ul>
		</section>

		<section class="tools-topic" aria-labelledby="topic-materials">
			<div class="tools-topic-head">
				<h2 id="topic-materials">실습 자료</h2>
				<p>단계 메뉴와 같은 줄에 두지 않습니다. 문제 정의 칸과 기록 원본입니다.</p>
			</div>
			<ul class="tools-list">
				<li>
					<a class="tools-card" href="/tools/hospital-data-pain-points/">
						<span class="tools-card-kicker">문제 정의 칸</span>
						<strong>Pain Point A–H</strong>
						<span>문제 발견에서 읽는 이름입니다. 순서는 A부터 H입니다.</span>
					</a>
				</li>
				<li>
					<a class="tools-card" href="/tools/consult-archive/">
						<span class="tools-card-kicker">기록 원본</span>
						<strong>상담 기록</strong>
						<span>새 대화에 지시문과 원문을 넣습니다. 답이 오면 같은 대화에 검산 질문을 넣습니다.</span>
					</a>
				</li>
				<li>
					<a class="tools-card" href="/tools/procedure-archive/">
						<span class="tools-card-kicker">기록 원본</span>
						<strong>시술 기록</strong>
						<span>울쎄라 문의 한 건으로 같은 순서를 합니다. 120건 목록은 아래에 접혀 있습니다.</span>
					</a>
				</li>
			</ul>
		</section>

		{
			TOOL_TOPICS.map((topic) => {
				const entries = archives.filter(
					(entry) => entry.data.topic === topic.id && entry.id !== 'hospital-data-pain-points',
				);
				if (entries.length === 0 && topic.id === 'hospital-data') return null;
				return (
					<section class="tools-topic" aria-labelledby={`topic-${topic.id}`}>
						<div class="tools-topic-head">
							<h2 id={`topic-${topic.id}`}>{topic.label}</h2>
							<p>{topic.note}</p>
						</div>
						{entries.length === 0 ? (
							<p class="tools-empty">아직 올라온 자료가 없습니다.</p>
						) : (
							<ul class="tools-list">
								{entries.map((entry) => (
									<li>
										<a class="tools-card" href={`/tools/${entry.id}/`}>
											<span class="tools-card-kicker">{topicLabel(entry.data.topic)}</span>
											<strong>{entry.data.title}</strong>
											<span>{entry.data.summary}</span>
											<em>{entry.data.items.length}개 항목 · 복사 · .md / .txt</em>
										</a>
									</li>
								))}
							</ul>
						)}
					</section>
				);
			})
		}
	</div>
</Layout>

<style>
	.tools-hub {
		padding: 1.25rem 0 2.25rem;
		max-width: 46rem;
	}
	.tools-kicker {
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		font-weight: 700;
		color: var(--pink);
	}
	.tools-head h1 {
		font-family: var(--display);
		font-size: clamp(1.8rem, 4vw, 2.4rem);
		letter-spacing: -0.03em;
		margin: 0.35rem 0 0.6rem;
	}
	.tools-lead,
	.tools-topic-head p,
	.tools-empty {
		color: var(--t2);
		line-height: 1.6;
	}
	.tools-topic {
		margin-top: 1.15rem;
	}
	.tools-topic-head h2 {
		font-family: var(--display);
		font-size: 1.25rem;
		margin: 0;
	}
	.tools-topic-head p,
	.tools-empty {
		margin: 0.35rem 0 0;
	}
	.tools-list {
		list-style: none;
		padding: 0;
		margin: 0.6rem 0 0;
		display: grid;
		gap: 0.6rem;
	}
	.tools-card {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding: 0.8rem 0.95rem;
		border: 1px solid var(--rule);
		border-radius: 9px;
		background: var(--bg2);
		text-decoration: none;
		color: inherit;
	}
	.tools-card:hover {
		border-color: var(--pink);
	}
	.tools-card-kicker,
	.tools-card em {
		font-style: normal;
		font-size: 0.78rem;
		color: var(--t3);
	}
	.tools-card strong {
		font-family: var(--display);
		font-size: 1.05rem;
	}
	.tools-card span:last-of-type {
		color: var(--t2);
		line-height: 1.55;
	}
</style>
