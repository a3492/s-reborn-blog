---
import { execFileSync } from 'node:child_process';
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../../layouts/Layout.astro';
import catalog from '../../data/procedure-public-catalog.json';

const downloadDir = path.join(process.cwd(), 'public/downloads/procedure-archive');
const guideName = '강의실습_따라하기.md';
const zipName = '시술기록_120건_공개용.zip';
for (const name of [guideName, zipName]) {
	fs.accessSync(path.join(downloadDir, name));
}
for (const item of catalog) {
	fs.accessSync(path.join(downloadDir, item.file));
}
if (catalog.length !== 120) {
	throw new Error(`시술 기록은 120건이어야 합니다. 현재 ${catalog.length}건`);
}
const expected: Record<string, number> = {
	'시술 전 체크': 18,
	'시술 중': 18,
	'귀가 안내': 18,
	'집에서 문의': 30,
	해피콜: 18,
	'부작용 재내원': 18,
};
for (const [label, count] of Object.entries(expected)) {
	const actual = catalog.filter((item) => item.categoryLabel === label).length;
	if (actual !== count) throw new Error(`${label}은 ${count}건이어야 합니다. 현재 ${actual}건`);
}
const blocked = /수정내역|정답표|정답|answer/i;
function walk(dir: string): string[] {
	const found: string[] = [];
	for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
		const full = path.join(dir, entry.name);
		if (entry.isDirectory()) found.push(...walk(full));
		else found.push(full);
	}
	return found;
}
for (const file of walk(downloadDir)) {
	if (blocked.test(path.basename(file))) throw new Error(`공개하면 안 되는 파일입니다: ${file}`);
	if (file.endsWith('.zip')) {
		const listing = execFileSync('unzip', ['-Z', '-1', file], { encoding: 'utf8' });
		if (blocked.test(listing)) throw new Error(`ZIP 안에 공개하면 안 되는 이름이 있습니다: ${file}`);
		const files = listing.split('\n').filter((line) => line && !line.endsWith('/'));
		if (files.length !== 120) throw new Error(`공개 ZIP은 120건이어야 합니다. 현재 ${files.length}건`);
	}
}

const categoryOrder = Object.keys(expected);
const packGroups = categoryOrder.map((label) => ({
	key: label,
	title: label,
	note: `${expected[label]}건`,
	items: catalog.filter((item) => item.categoryLabel === label),
}));
const packWriters = [...new Set(catalog.map((item) => item.writer))].sort((a, b) => a.localeCompare(b, 'ko'));
const packGrades = ['XS', 'S', 'M', 'L', 'XL', 'XXL'];

function fileHref(name: string): string {
	return `/downloads/procedure-archive/${name.split('/').map((part) => encodeURIComponent(part)).join('/')}`;
}
function viewHref(id: string): string {
	return `/tools/procedure-archive/view/${encodeURIComponent(id)}/`;
}
---

<Layout
	title="시술 기록 자료실"
	description="120건 원본을 찾아 보고 받습니다. 울쎄라, 필러, 토닝."
>
	<article class="consult" data-pack data-tool-page="procedure-archive">
		<header>
			<p class="consult-kicker">
				<a href="/tools/">경영 도구 아카이브</a>
				<span aria-hidden="true"> / </span>
				시술 기록 자료실
			</p>
			<h1>시술 기록 자료실</h1>
			<p class="consult-virtual">모두 실습용 가상 데이터입니다</p>
			<p class="consult-lead">120건 원본을 찾아 보고 받습니다.</p>
			<p class="consult-guide-link">
				<a class="tool-action" href="/tools/procedure-archive/guide/">강의 실습 따라하기</a>
				<span>강연에서 단계별로 AI 실습을 합니다.</span>
			</p>
		</header>

		<section class="consult-panel" aria-labelledby="procedure-files">
			<h2 id="procedure-files">공개 자료 받기</h2>
			<ul class="pack-downloads">
				<li>
					<strong>{zipName}</strong>
					<p>자료실의 원본 120건을 한 번에 받습니다. 울쎄라, 필러, 토닝.</p>
					<a class="tool-action" href={fileHref(zipName)} download={zipName}>ZIP 받기</a>
				</li>
			</ul>
		</section>

		<section class="consult-panel tool-filter-panel" aria-labelledby="procedure-list">
			<h2 id="procedure-list">원본 목록</h2>
			<label class="consult-search">
				<span class="tool-filter-label">목록 검색</span>
				<input class="tool-filter-search" type="search" data-pack-search placeholder="이름, 시술, 번호, 작성자" />
			</label>
			<fieldset class="tool-filter-group">
				<legend class="tool-filter-label">카테고리</legend>
				<div class="consult-chips">
					{categoryOrder.map((label) => (
						<button class="tool-filter-chip" type="button" data-pack-filter="category" data-pack-value={label} aria-pressed="false">
							{label}
						</button>
					))}
				</div>
			</fieldset>
			<fieldset class="tool-filter-group">
				<legend class="tool-filter-label">작성자</legend>
				<div class="consult-chips">
					{packWriters.map((writer) => (
						<button class="tool-filter-chip" type="button" data-pack-filter="writer" data-pack-value={writer} aria-pressed="false">
							{writer}
						</button>
					))}
				</div>
			</fieldset>
			<fieldset class="tool-filter-group">
				<legend class="tool-filter-label">길이</legend>
				<div class="consult-chips">
					{packGrades.map((grade) => (
						<button class="tool-filter-chip" type="button" data-pack-filter="grade" data-pack-value={grade} aria-pressed="false">
							{grade}
						</button>
					))}
				</div>
			</fieldset>
			<p class="consult-count" data-pack-count>{catalog.length}건 표시</p>
			{
				packGroups.map((group) => (
					<div class="pack-group">
						<h3>
							{group.title} · <span data-pack-group-count={group.items.length}>{group.items.length}</span>건
						</h3>
						<p>{group.note}</p>
						<ul class="pack-list">
							{group.items.map((item) => (
								<li
									data-pack-item
									data-category={item.categoryLabel}
									data-writer={item.writer}
									data-grade={item.grade}
									data-pack-text={`${item.title} ${item.name} ${item.preview} ${item.id} ${item.customer} ${item.channel} ${item.procedure} ${item.writer} ${item.grade}`}
								>
									<strong class="pack-title">{item.title}</strong>
									<p class="pack-staff">작성자 {item.writer}</p>
									<p class="pack-chars">{item.chars.toLocaleString('ko-KR')}자 · {item.grade}</p>
									<p class="pack-voice">
										<span>미리보기</span>
										{item.preview}
									</p>
									<p class="pack-meta">{item.id} · {item.customer} · {item.channel}</p>
									<div class="pack-actions">
										<a href={viewHref(item.id)}>원본 보기</a>
										<a href={fileHref(item.file)} download={item.file.split('/').pop()}>개별 다운로드</a>
									</div>
								</li>
							))}
						</ul>
					</div>
				))
			}
			<p class="consult-empty" data-pack-empty hidden>조건에 맞는 기록이 없습니다.</p>
		</section>
	</article>
</Layout>

<script>
	const pack = document.querySelector('[data-pack]');
	const packSearch = pack?.querySelector('[data-pack-search]');
	const packItems = [...(pack?.querySelectorAll('[data-pack-item]') ?? [])];
	const packCount = pack?.querySelector('[data-pack-count]');
	const packEmpty = pack?.querySelector('[data-pack-empty]');
	const packSelected = new Map();

	function packFiltering() {
		if (packSearch instanceof HTMLInputElement && packSearch.value.trim() !== '') return true;
		for (const values of packSelected.values()) {
			if (values.size > 0) return true;
		}
		return false;
	}

	function applyPack() {
		const query = packSearch instanceof HTMLInputElement ? packSearch.value.trim() : '';
		const filtering = packFiltering();
		let shown = 0;
		for (const item of packItems) {
			if (!(item instanceof HTMLElement)) continue;
			const text = item.dataset.packText ?? '';
			const matchesQuery = query === '' || text.includes(query);
			let matchesFilters = true;
			for (const [key, values] of packSelected) {
				if (values.size === 0) continue;
				const current = item.dataset[key] ?? '';
				if (!values.has(current)) matchesFilters = false;
			}
			const visible = matchesQuery && matchesFilters;
			item.hidden = !visible;
			if (visible) shown += 1;
		}
		for (const group of pack?.querySelectorAll('.pack-group') ?? []) {
			if (!(group instanceof HTMLElement)) continue;
			const entries = [...group.querySelectorAll('[data-pack-item]')].filter(
				(entry) => entry instanceof HTMLElement,
			);
			const visibleCount = entries.filter((entry) => !entry.hidden).length;
			const countLabel = group.querySelector('[data-pack-group-count]');
			if (countLabel) countLabel.textContent = String(visibleCount);
			group.hidden = filtering && visibleCount === 0;
		}
		if (packCount) packCount.textContent = `${shown}건 표시`;
		if (packEmpty instanceof HTMLElement) packEmpty.hidden = shown !== 0;
	}

	pack?.addEventListener('click', (event) => {
		const target = event.target;
		if (!(target instanceof HTMLButtonElement)) return;
		const filter = target.dataset.packFilter;
		const value = target.dataset.packValue;
		if (!filter || !value) return;
		const values = packSelected.get(filter) ?? new Set();
		if (values.has(value)) values.delete(value);
		else values.add(value);
		packSelected.set(filter, values);
		target.setAttribute('aria-pressed', values.has(value) ? 'true' : 'false');
		applyPack();
	});
	packSearch?.addEventListener('input', applyPack);

	const presetCategory = new URLSearchParams(location.search).get('category');
	if (presetCategory) {
		const preset = pack?.querySelector(`[data-pack-filter="category"][data-pack-value="${CSS.escape(presetCategory)}"]`);
		if (preset instanceof HTMLButtonElement) preset.click();
		document.getElementById('procedure-list')?.scrollIntoView();
	}
</script>

<style>
	.consult {
		box-sizing: border-box;
		min-width: 0;
		padding: 2.2rem 0 4rem;
		max-width: 72rem;
		--tool-radius-button: 6px;
		--tool-radius-card: 8px;
		--tool-border: #d6d9dc;
		--tool-ink: #1f2937;
		--tool-mint-active: #d9f3eb;
		--tool-navy: #17344b;
	}
	.consult-kicker {
		font-size: 0.78rem;
		color: var(--t3);
	}
	.consult-kicker a {
		color: var(--pink);
		font-weight: 700;
		text-decoration: none;
	}
	.consult h1,
	.consult h2,
	.consult h3 {
		font-family: var(--display);
	}
	.consult h1 {
		font-size: clamp(1.8rem, 4vw, 2.35rem);
		letter-spacing: -0.03em;
		margin: 0.4rem 0 0.7rem;
	}
	.consult-virtual {
		margin: 0 0 0.45rem;
		font-weight: 800;
	}
	.consult-lead,
	.consult-panel p {
		color: var(--t2);
		line-height: 1.65;
	}
	.consult-guide-link {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 12px 0 0;
	}
	.consult-steps {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 12px 0 0;
		padding: 0;
		list-style: none;
	}
	.consult-steps li,
	.tool-action,
	.pack-list a,
	.pack-downloads a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		box-sizing: border-box;
		min-height: 36px;
		padding: 6px 12px;
		border-radius: 6px;
		background: #fff;
		border: 1px solid var(--tool-border);
		color: var(--tool-ink);
		font-size: 13px;
		font-weight: 600;
		line-height: 1.3;
		text-decoration: none;
	}
	.consult-panel {
		margin-top: 1rem;
		padding: 16px;
		border: 1px solid var(--rule);
		border-radius: 8px;
		background: var(--bg2);
	}
	.consult h2 {
		margin: 0 0 0.45rem;
		font-size: 1.15rem;
	}
	.consult h3 {
		margin: 1rem 0 0.35rem;
		font-size: 1rem;
	}
	.consult-search {
		display: grid;
		gap: 6px;
		margin-top: 12px;
		font-weight: 700;
	}
	.consult-search input {
		box-sizing: border-box;
		width: 100%;
		min-height: 38px;
		padding: 8px 12px;
		border: 1px solid var(--tool-border);
		border-radius: 6px;
		font: inherit;
		font-size: 14px;
		background: #fff;
	}
	fieldset {
		margin: 12px 0 0;
		padding: 0;
		border: 0;
	}
	legend {
		display: block;
		margin-bottom: 6px;
		font-size: 13px;
		font-weight: 700;
	}
	.consult-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}
	.tool-filter-chip {
		display: inline-flex;
		align-items: center;
		box-sizing: border-box;
		min-height: 32px;
		padding: 5px 10px;
		border: 1px solid var(--tool-border);
		border-radius: 6px;
		background: #fff;
		color: var(--tool-ink);
		font: inherit;
		font-weight: 600;
		font-size: 13px;
		cursor: pointer;
	}
	.tool-filter-chip[aria-pressed='true'] {
		background: var(--tool-mint-active);
		border-color: #288a75;
		color: var(--tool-navy);
	}
	.tool-filter-chip:focus-visible,
	.tool-action:focus-visible,
	.pack-list a:focus-visible {
		outline: 3px solid #2668b5;
		outline-offset: 2px;
	}
	.consult-count {
		margin: 12px 0 0;
		font-weight: 700;
	}
	.pack-downloads,
	.pack-list {
		list-style: none;
		padding: 0;
		margin: 12px 0 0;
		display: grid;
		gap: 10px;
	}
	.pack-downloads li,
	.pack-list li {
		min-width: 0;
		padding: 12px;
		border: 1px solid var(--tool-border);
		border-radius: 8px;
		background: #fff;
	}
	.pack-list li {
		display: grid;
		gap: 2px;
	}
	.pack-list li[hidden],
	.pack-group[hidden],
	.consult-empty[hidden] {
		display: none;
	}
	.pack-title {
		font-size: 1rem;
		line-height: 1.4;
	}
	.pack-meta,
	.pack-staff,
	.pack-chars {
		margin: 4px 0 0;
		color: var(--t3);
		font-size: 0.82rem;
		line-height: 1.4;
	}
	.pack-chars {
		font-weight: 700;
		color: var(--text);
	}
	.pack-voice {
		margin: 8px 0 0;
		color: var(--t2);
		line-height: 1.5;
	}
	.pack-voice span {
		display: inline-block;
		margin-right: 6px;
		padding: 1px 6px;
		border-radius: 6px;
		background: #fff;
		border: 1px solid var(--tool-border);
		color: var(--tool-navy);
		font-size: 12px;
		font-weight: 700;
	}
	.pack-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}
	.consult-empty {
		margin: 12px 0 0;
		font-weight: 700;
	}
	@media (max-width: 600px) {
		.consult-steps li,
		a.tool-action,
		.pack-downloads a,
		.pack-list a {
			min-height: 44px;
			padding: 10px 12px;
			font-size: 14px;
		}
		.tool-filter-chip {
			min-height: 36px;
			padding: 8px 10px;
			font-size: 13px;
		}
		.consult-search input {
			min-height: 44px;
			font-size: 16px;
		}
	}
	@media (pointer: coarse) {
		.tool-filter-chip {
			min-height: 44px;
		}
	}
</style>
