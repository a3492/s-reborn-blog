---

<Layout
	title="상담데이터 아카이브"
	description="흩어진 상담 원본 예시 16개. 경로, 형태, 단계, 시술, 난이도로 고르는 실습 초안."
>
	<article class="consult" data-consult>
		<header>
			<p class="consult-kicker">
				<a href="/tools/">경영 도구 아카이브</a>
				<span aria-hidden="true"> / </span>
				상담 데이터
			</p>
			<h1>상담데이터 아카이브</h1>
			<p class="consult-virtual">모두 실습용 가상 데이터입니다</p>
			<p class="consult-lead">
				대화, 알림, 메모가 한 표가 되기 전의 원본 예시입니다. 지금은 경로별 2개씩 16개이고, 240건은 제작 목표입니다.
			</p>
			<ol class="consult-steps">
				<li>고르기</li>
				<li>복사하기</li>
				<li>AI에 넣기</li>
				<li>검산하기</li>
			</ol>
		</header>

		<section class="consult-panel" aria-labelledby="consult-find">
			<h2 id="consult-find">예시 고르기</h2>
			<label class="consult-search">
				<span>검색</span>
				<input type="search" data-search placeholder="인스타, 울쎄라, 예약, 오타" />
			</label>
			{
				filters.map((group) => (
					<fieldset>
						<legend>{group.label}</legend>
						<div class="consult-chips">
							{group.options.map(([value, label]) => (
								<button type="button" data-filter={group.key} data-value={value} aria-pressed="false">
									{label}
								</button>
							))}
						</div>
					</fieldset>
				))
			}
			<p class="consult-count" data-count>{samples.length}개 표시</p>
			<ul class="consult-cards">
				{
					samples.map((sample) => (
						<li
							data-card
							data-path={sample.path}
							data-form={sample.form}
							data-stage={sample.stage}
							data-field={sample.field}
							data-level={sample.level}
							data-text={`${sample.id} ${sample.title} ${sample.pathLabel} ${sample.formLabel} ${sample.stageLabel} ${sample.fieldLabel} ${sample.body}`}
						>
							<div class="consult-card-top">
								<strong>
									{sample.id}. {sample.title}
								</strong>
								<span>{sample.levelLabel}</span>
							</div>
							<p class="consult-tags">
								{sample.pathLabel} · {sample.formLabel} · {sample.stageLabel} · {sample.fieldLabel}
							</p>
							<pre id={`sample-${sample.id}`}>{sample.body}</pre>
							<button type="button" data-copy={`sample-${sample.id}`}>
								원문 복사
							</button>
						</li>
					))
				}
			</ul>
			<p class="consult-empty" data-empty hidden>조건에 맞는 예시가 없습니다.</p>
		</section>

		<section class="consult-panel" aria-labelledby="consult-tasks">
			<h2 id="consult-tasks">붙여 넣는 문장</h2>
			<p>정답표는 이 페이지에 없습니다. 아래는 결과의 모양만 확인합니다.</p>
			{
				prompts.map((prompt) => (
					<article class="consult-task">
						<h3>{prompt.title}</h3>
						<pre id={`prompt-${prompt.id}`}>{prompt.text}</pre>
						<button type="button" data-copy={`prompt-${prompt.id}`}>
							문장 복사
						</button>
						<p>{prompt.success}</p>
					</article>
				))
			}
		</section>
		<p class="consult-status" data-status role="status" aria-live="polite"></p>
	</article>
</Layout>

<script>
	const root = document.querySelector('[data-consult]');
	const search = root?.querySelector('[data-search]');
	const cards = [...(root?.querySelectorAll('[data-card]') ?? [])];
	const count = root?.querySelector('[data-count]');
	const empty = root?.querySelector('[data-empty]');
	const status = root?.querySelector('[data-status]');
	const selected = new Map();

	function apply() {
		const query = search instanceof HTMLInputElement ? search.value.trim() : '';
		let shown = 0;
		for (const card of cards) {
			if (!(card instanceof HTMLElement)) continue;
			const text = card.dataset.text ?? '';
			const matchesQuery = query === '' || text.includes(query);
			let matchesFilters = true;
			for (const [key, values] of selected) {
				if (values.size === 0) continue;
				const current = card.dataset[key] ?? '';
				if (!values.has(current)) matchesFilters = false;
			}
			const visible = matchesQuery && matchesFilters;
			card.hidden = !visible;
			if (visible) shown += 1;
		}
		if (count) count.textContent = `${shown}개 표시`;
		if (empty instanceof HTMLElement) empty.hidden = shown !== 0;
	}

	root?.addEventListener('click', async (event) => {
		const target = event.target;
		if (!(target instanceof HTMLButtonElement)) return;
		const filter = target.dataset.filter;
		const value = target.dataset.value;
		if (filter && value) {
			const values = selected.get(filter) ?? new Set();
			if (values.has(value)) values.delete(value);
			else values.add(value);
			selected.set(filter, values);
			target.setAttribute('aria-pressed', values.has(value) ? 'true' : 'false');
			apply();
			return;
		}
		const copyId = target.dataset.copy;
		if (!copyId) return;
		const text = document.getElementById(copyId)?.textContent?.trim() ?? '';
		const label = target.textContent ?? '복사';
		try {
			await navigator.clipboard.writeText(text);
		} catch {
			const area = document.createElement('textarea');
			area.value = text;
			area.setAttribute('readonly', '');
			area.style.position = 'fixed';
			area.style.left = '-9999px';
			document.body.appendChild(area);
			area.select();
			document.execCommand('copy');
			area.remove();
		}
		target.textContent = '복사됨';
		if (status) status.textContent = '복사했습니다.';
		window.setTimeout(() => {
			target.textContent = label;
		}, 1600);
	});

	search?.addEventListener('input', apply);
</script>

