---
import { execFileSync } from 'node:child_process';
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../../layouts/Layout.astro';
import ConsultPractice from '../../components/ConsultPractice.astro';
import catalogJson from '../../data/consult-public-catalog.json';
import {
	fileHref,
	gradeFilters,
	groupByCustomer,
	lengthLabel,
	previewLine,
	viewHref,
	writerLabel,
	type ConsultRecord,
} from '../../lib/consult-archive';

const catalog = catalogJson as ConsultRecord[];
const downloadDir = path.join(process.cwd(), 'public/downloads/consult-archive');
const guideName = '상담데이터_가공_연습가이드_공개용.md';
const zipFiles = ['상담데이터_1차_공개용.zip', '상담데이터_2차_공개용.zip'];
const longFiles = [
	'items/B02-L01_초진고민많은고객_B02-C021_녹취형.md',
	'items/B02-L02_부작용걱정재진_B01-C009_녹취형.md',
	'items/B02-L03_보호자동반_B02-C026_녹취형.md',
	'items/B02-L04_VIP패키지재계약_B01-C005_녹취형.md',
];
for (const name of [guideName, ...zipFiles, ...longFiles]) {
	fs.accessSync(path.join(downloadDir, name));
}
for (const item of catalog) {
	fs.accessSync(path.join(downloadDir, item.file));
}
const guideMarkdown = fs.readFileSync(path.join(downloadDir, guideName), 'utf8');
if (/정답|answer/i.test(guideMarkdown)) {
	throw new Error('가공 연습 가이드에 정답표 문구가 있습니다.');
}
function walkPublic(dir: string): string[] {
	const found: string[] = [];
	for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
		const full = path.join(dir, entry.name);
		if (entry.isDirectory()) found.push(...walkPublic(full));
		else found.push(full);
	}
	return found;
}
const blocked = /정답표|정답|answer/i;
for (const file of walkPublic(path.join(process.cwd(), 'public'))) {
	if (blocked.test(file)) {
		throw new Error(`공개 경로에 금지 파일이 있습니다: ${file}`);
	}
	if (file.endsWith('.zip')) {
		const listing = execFileSync('unzip', ['-Z', '-1', file], { encoding: 'utf8' });
		if (blocked.test(listing) || listing.includes('03_정답표')) {
			throw new Error(`ZIP 안에 금지 이름이 있습니다: ${file}`);
		}
	}
}
if (catalog.length !== 364) {
	throw new Error(`상담 원본 목록은 364건이어야 합니다. 현재 ${catalog.length}건`);
}
const longItems = catalog.filter((item) => item.id.startsWith('B02-L'));
const secondItems = catalog.filter((item) => item.batch === '2차' && !item.id.startsWith('B02-L'));
const firstItems = catalog.filter((item) => item.batch === '1차');
if (longItems.length !== 4 || secondItems.length !== 240 || firstItems.length !== 120) {
	throw new Error(
		`목록 개수가 맞지 않습니다. 장시간 ${longItems.length}, 2차 ${secondItems.length}, 1차 ${firstItems.length}`,
	);
}

const customers = groupByCustomer(catalog);
const packChannels = [...new Set(catalog.map((item) => item.channel))];
const packWriters = [...new Set(catalog.map((item) => item.writer))].sort((a, b) =>
	writerLabel(a).localeCompare(writerLabel(b), 'ko'),
);
---

<Layout
	title="상담데이터 아카이브"
	description="한 고객의 카톡, 전화, 내원 상담을 모아 읽는 실습 자료입니다. 짧은 메모는 조각이고, 장시간 상담은 따로 있습니다."
>
	<article class="consult" data-tool-page="consult-archive">
		<header>
			<p class="consult-kicker">
				<a href="/tools/">경영 도구 아카이브</a>
				<span aria-hidden="true"> / </span>
				상담 데이터
			</p>
			<h1>상담데이터 아카이브</h1>
			<p class="consult-virtual">모두 실습용 가상 데이터입니다. 실제 환자 정보는 올리지 마세요.</p>
			<p class="consult-lead">
				카톡 한 줄, 전화 메모, 내원 상담이 한 고객에게 따로 쌓여 있습니다. 짧은 글은 미완성이 아니라 그 경로에 남은 조각입니다. 아래에서는 한 사람씩 모아 읽습니다.
			</p>
			<p class="consult-aside">
				<a href="/tools/consult-archive/guide/">이 순서를 글로 읽기</a>
			</p>
		</header>

		<ConsultPractice />

		<section class="consult-panel" aria-labelledby="all-title">
			<h2 id="all-title">60명을 고객별로 찾기</h2>
			<p>
				기록 364건, 고객 60명입니다. 장시간 상담이 있는 사람을 먼저 둡니다. 짧은 메모는 그 고객 안에 들어 있습니다.
			</p>
			<details id="all" class="fold" data-pack>
				<summary>전체 목록 열기 · {customers.length}명 · {catalog.length}건</summary>
				<label class="consult-search">
					<span>목록 검색</span>
					<input type="search" data-pack-search placeholder="이름, 경로, 번호, 작성자" />
				</label>
				<fieldset>
					<legend>배치</legend>
					<div class="chips">
						<button type="button" data-pack-filter="batch" data-pack-value="1차" aria-pressed="false">1차</button>
						<button type="button" data-pack-filter="batch" data-pack-value="2차" aria-pressed="false">2차</button>
					</div>
				</fieldset>
				<fieldset>
					<legend>경로</legend>
					<div class="chips">
						{packChannels.map((channel) => (
							<button type="button" data-pack-filter="channel" data-pack-value={channel} aria-pressed="false">
								{channel}
							</button>
						))}
					</div>
				</fieldset>
				<fieldset>
					<legend>작성자</legend>
					<div class="chips">
						{packWriters.map((writer) => (
							<button type="button" data-pack-filter="writer" data-pack-value={writer} aria-pressed="false">
								{writerLabel(writer)}
							</button>
						))}
					</div>
				</fieldset>
				<fieldset>
					<legend>길이</legend>
					<div class="chips">
						{gradeFilters.map(([grade, label]) => (
							<button type="button" data-pack-filter="grade" data-pack-value={grade} aria-pressed="false">
								{label}
							</button>
						))}
					</div>
				</fieldset>
				<p class="consult-count" data-pack-count>{catalog.length}건 표시</p>
				{
					customers.map((group) => (
						<details class="person" id={`customer-${group.customer}`} data-person>
							<summary>
								<strong>{group.name}</strong>
								<span>
									<span data-person-count={group.items.length}>{group.items.length}</span>건
									· {group.longCount > 0 ? `장시간 상담 ${group.longCount}건 · ` : '장시간 상담 없음 · '}
									합계 {group.chars.toLocaleString('ko-KR')}자
								</span>
								<small>{group.channels.join(' · ')}</small>
							</summary>
							<ul class="person-list">
								{group.items.map((item) => (
									<li
										class="record-row"
										data-pack-item
										data-batch={item.batch}
										data-channel={item.channel}
										data-writer={item.writer}
										data-grade={item.grade}
										data-pack-text={`${item.title} ${item.name} ${item.preview} ${item.id} ${item.customer} ${item.channel} ${item.writer} ${item.grade} ${item.batch} ${writerLabel(item.writer)}`}
									>
										<div class="record-top">
											<strong>{item.title}</strong>
											<span>{lengthLabel(item)}</span>
										</div>
										<p class="record-meta">{item.channel} · {writerLabel(item.writer)} · {item.id}</p>
										<p class="record-preview">{previewLine(item.preview)}</p>
										<div class="record-actions">
											<a href={viewHref(item.id)}>원문 읽기</a>
											<a href={fileHref(item.file)} download={item.file.split('/').pop()}>파일 받기</a>
										</div>
									</li>
								))}
							</ul>
						</details>
					))
				}
				<p class="consult-empty" data-pack-empty hidden>이 조건의 기록이 없습니다.</p>
			</details>
		</section>

		<section class="consult-panel" aria-labelledby="files-title">
			<h2 id="files-title">파일로 받기</h2>
			<p>
				압축을 풀면 짧은 텍스트가 많이 보입니다. 파일 하나는 카톡 한 번이거나 전화 한 통입니다. 화면에서 고객별로 모아 읽고, 강연에서 폴더가 필요할 때 받으세요.
			</p>
			<ul class="downloads">
				<li>
					<strong>상담데이터_1차_공개용.zip</strong>
					<p>짧은 첫 기록 120건입니다. 고객 20명의 조각입니다.</p>
					<a href={fileHref('상담데이터_1차_공개용.zip')} download="상담데이터_1차_공개용.zip">1차 ZIP</a>
				</li>
				<li>
					<strong>상담데이터_2차_공개용.zip</strong>
					<p>일반 원본 240건과 장시간 상담 4건입니다.</p>
					<a href={fileHref('상담데이터_2차_공개용.zip')} download="상담데이터_2차_공개용.zip">2차 ZIP</a>
				</li>
				<li>
					<strong>강연 원고</strong>
					<p>폴더 경로와 시간 배분이 적힌 원고입니다. 화면에서 따라갈 때는 위 네 단계를 쓰면 됩니다.</p>
					<a href={fileHref(guideName)} download={guideName}>원고 받기</a>
				</li>
			</ul>
		</section>
	</article>
</Layout>

<script>
	const pack = document.querySelector('[data-pack]');
	const packSearch = pack?.querySelector('[data-pack-search]');
	const packItems = [...(pack?.querySelectorAll('[data-pack-item]') ?? [])];
	const packCount = pack?.querySelector('[data-pack-count]');
	const packEmpty = pack?.querySelector('[data-pack-empty]');
	const packSelected = new Map();

	function packFiltering() {
		if (packSearch instanceof HTMLInputElement && packSearch.value.trim() !== '') return true;
		for (const values of packSelected.values()) {
			if (values.size > 0) return true;
		}
		return false;
	}

	function applyPack() {
		const query = packSearch instanceof HTMLInputElement ? packSearch.value.trim() : '';
		const filtering = packFiltering();
		let shown = 0;
		for (const item of packItems) {
			if (!(item instanceof HTMLElement)) continue;
			const text = item.dataset.packText ?? '';
			const matchesQuery = query === '' || text.includes(query);
			let matchesFilters = true;
			for (const [key, values] of packSelected) {
				if (values.size === 0) continue;
				const current = item.dataset[key] ?? '';
				if (!values.has(current)) matchesFilters = false;
			}
			const visible = matchesQuery && matchesFilters;
			item.hidden = !visible;
			if (visible) shown += 1;
		}
		for (const group of pack?.querySelectorAll('[data-person]') ?? []) {
			if (!(group instanceof HTMLElement)) continue;
			const entries = [...group.querySelectorAll('[data-pack-item]')].filter(
				(entry) => entry instanceof HTMLElement,
			);
			const visibleCount = entries.filter((entry) => !entry.hidden).length;
			const countLabel = group.querySelector('[data-person-count]');
			if (countLabel) countLabel.textContent = String(visibleCount);
			const any = visibleCount > 0;
			group.hidden = filtering && !any;
			if (group instanceof HTMLDetailsElement) {
				if (filtering && any) group.open = true;
				if (!filtering) group.open = false;
			}
		}
		if (packCount) packCount.textContent = `${shown}건 표시`;
		if (packEmpty instanceof HTMLElement) packEmpty.hidden = shown !== 0;
	}

	function openFromHash() {
		const hash = decodeURIComponent(location.hash.replace(/^#/, ''));
		if (!hash.startsWith('customer-')) return;
		if (pack instanceof HTMLDetailsElement) pack.open = true;
		const person = document.getElementById(hash);
		if (person instanceof HTMLDetailsElement) {
			person.open = true;
			person.scrollIntoView({ block: 'start' });
		}
	}

	pack?.addEventListener('click', (event) => {
		const target = event.target;
		if (!(target instanceof HTMLButtonElement)) return;
		const filter = target.dataset.packFilter;
		const value = target.dataset.packValue;
		if (!filter || !value) return;
		const values = packSelected.get(filter) ?? new Set();
		if (values.has(value)) values.delete(value);
		else values.add(value);
		packSelected.set(filter, values);
		target.setAttribute('aria-pressed', values.has(value) ? 'true' : 'false');
		applyPack();
	});
	packSearch?.addEventListener('input', applyPack);
	openFromHash();
	window.addEventListener('hashchange', openFromHash);
</script>

<style>
	.consult {
		box-sizing: border-box;
		min-width: 0;
		max-width: 48rem;
		padding: 2.2rem 0 4rem;
	}
	.consult-kicker {
		font-size: 0.78rem;
		color: var(--t3);
	}
	.consult-kicker a,
	.consult-aside a {
		color: var(--pink);
		font-weight: 700;
		text-decoration: none;
	}
	.consult h1,
	.consult h2 {
		font-family: var(--display);
		letter-spacing: -0.03em;
	}
	.consult h1 {
		font-size: clamp(1.8rem, 4vw, 2.35rem);
		margin: 0.4rem 0 0.7rem;
	}
	.consult-virtual {
		margin: 0 0 0.45rem;
		font-weight: 800;
	}
	.consult-lead,
	.consult-panel p,
	.record-preview,
	.record-meta {
		color: var(--t2);
		line-height: 1.65;
	}
	.consult-aside {
		margin: 0.8rem 0 0;
	}
	.consult-panel {
		margin-top: 1.4rem;
		padding: 16px;
		border: 1px solid var(--rule);
		border-radius: 8px;
		background: var(--bg2);
	}
	.consult h2 {
		margin: 0 0 0.45rem;
		font-size: 1.15rem;
	}
	.fold,
	.person {
		margin-top: 12px;
	}
	.fold > summary,
	.person > summary {
		cursor: pointer;
	}
	.fold > summary {
		display: inline-flex;
		align-items: center;
		min-height: 36px;
		padding: 6px 12px;
		border: 1px solid #d6d9dc;
		border-radius: 6px;
		background: #fff;
		font-weight: 700;
	}
	.person > summary {
		display: grid;
		gap: 2px;
		padding: 10px 12px;
		border: 1px solid #d6d9dc;
		border-radius: 8px;
		background: #fff;
	}
	.person > summary span,
	.person > summary small {
		color: var(--t2);
		font-weight: 500;
		line-height: 1.45;
	}
	.consult-search {
		display: grid;
		gap: 6px;
		margin-top: 12px;
		font-weight: 700;
	}
	.consult-search input {
		box-sizing: border-box;
		width: 100%;
		min-height: 38px;
		padding: 8px 12px;
		border: 1px solid #d6d9dc;
		border-radius: 6px;
		font: inherit;
		font-size: 14px;
		background: #fff;
	}
	fieldset {
		margin: 12px 0 0;
		padding: 0;
		border: 0;
	}
	legend {
		margin-bottom: 6px;
		font-size: 13px;
		font-weight: 700;
	}
	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}
	.chips button,
	.record-actions a,
	.downloads a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		box-sizing: border-box;
		border: 1px solid #d6d9dc;
		border-radius: 6px;
		background: #fff;
		color: #1f2937;
		font: inherit;
		font-weight: 700;
		text-decoration: none;
		cursor: pointer;
	}
	.chips button {
		min-height: 32px;
		padding: 5px 10px;
		font-size: 13px;
	}
	.chips button[aria-pressed='true'] {
		background: #d9f3eb;
		border-color: #288a75;
		color: #17344b;
	}
	.consult-count {
		margin: 12px 0 0;
		font-weight: 700;
	}
	.person-list,
	.downloads {
		list-style: none;
		margin: 8px 0 0;
		padding: 0;
		display: grid;
		gap: 8px;
	}
	.record-row,
	.downloads li {
		padding: 12px;
		border: 1px solid #d6d9dc;
		border-radius: 8px;
		background: #fff;
	}
	.record-top {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 6px;
	}
	.record-top span {
		color: #17344b;
		font-size: 13px;
		font-weight: 700;
	}
	.record-meta,
	.record-preview,
	.downloads p {
		margin: 4px 0 0;
	}
	.record-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}
	.record-actions a,
	.downloads a {
		min-height: 36px;
		margin-top: 8px;
		padding: 6px 12px;
		font-size: 13px;
	}
	.record-row[hidden],
	.person[hidden],
	.consult-empty[hidden] {
		display: none;
	}
	.chips button:focus-visible,
	.record-actions a:focus-visible,
	.downloads a:focus-visible,
	.fold > summary:focus-visible,
	.person > summary:focus-visible {
		outline: 3px solid #2668b5;
		outline-offset: 2px;
	}
	@media (max-width: 600px) {
		.chips button,
		.record-actions a,
		.downloads a,
		.fold > summary {
			min-height: 44px;
			padding: 10px 12px;
			font-size: 14px;
		}
		.consult-search input {
			min-height: 44px;
			font-size: 16px;
		}
	}
</style>
