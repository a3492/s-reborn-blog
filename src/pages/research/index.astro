---
import BrandChrome from '../../components/brand/BrandChrome.astro';
import '../../styles/brand-home.css';
import '../../styles/research.css';
import { RESEARCH_AREAS } from '../../lib/research/tree';
import { loadResearchTree } from '../../lib/research/load';

const { roots } = loadResearchTree();
---

<BrandChrome
	title="연구 | S—REBORN"
	description="김도위의 세 연구 영역. Multi-AI Operating System, Human–AI Cognitive Interface, AI Workflow Engineering."
	canonicalPath="/research/"
	current="research"
>
	<main class="research-page">
		<p class="research-kicker">02 / CURRENT RESEARCH</p>
		<h1 class="research-title">AI를 사용하는 방법<br />그 자체를 연구합니다.</h1>
		<p class="research-lead">세 영역을 최상위 루트로 두고, Notion에 있는 문서만 공개합니다. 제목만 보이는 항목은 아직 본문을 공개하지 않은 후속 집필입니다.</p>
		<div class="research-index">
			{roots.map((root) => (
				<a class="research-hub" href={root.path}>
					<div>
						<b>{root.title}</b>
						<small>{root.description || RESEARCH_AREAS[root.researchArea].summary}</small>
					</div>
					<span>↗</span>
				</a>
			))}
		</div>
	</main>
</BrandChrome>
