---
import '../styles/design.css';
import BaseHead from '../components/BaseHead.astro';
import BlogSearchScript from '../components/BlogSearchScript.astro';
import Topbar from '../components/Topbar.astro';
import Footer from '../components/Footer.astro';
import PageShare from '../components/PageShare.astro';
import { SITE_TITLE, SITE_DESCRIPTION, CONTACT_EMAIL } from '../consts';
import { buildSearchIndex } from '../lib/search-index';
import { getPublicSiteSettings } from '../lib/site-settings';

interface Props {
	title?: string;
	description?: string;
	lang?: 'ko' | 'en';
	noindex?: boolean;
}

const { title, description = SITE_DESCRIPTION, lang = 'ko', noindex = false } = Astro.props;
const siteSettings = await getPublicSiteSettings();
const resolvedSiteTitle = siteSettings.siteTitle || SITE_TITLE;
const resolvedDescription = description || siteSettings.siteDescription || SITE_DESCRIPTION;

const searchIndex = await buildSearchIndex(lang === 'en');
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead
      title={title ? `${title} | ${resolvedSiteTitle}` : resolvedSiteTitle}
      description={resolvedDescription}
      image={siteSettings.defaultOgImage || undefined}
      siteTitle={resolvedSiteTitle}
      noindex={noindex}
    />
	</head>
	<body>
		<div class="site-wrap">
			<Topbar siteTitle={resolvedSiteTitle} lang={lang} pageTitle={title} />
			<main class="site-main">
				<slot />
			</main>
			<Footer siteTitle={resolvedSiteTitle} socialLinks={siteSettings.socialLinks} />
			<PageShare />
		</div>

		<BlogSearchScript
			searchIndex={searchIndex}
			supabaseUrl={import.meta.env.PUBLIC_SUPABASE_URL ?? ''}
			supabaseKey={import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? ''}
			contactEmail={CONTACT_EMAIL}
		/>
	</body>
</html>
