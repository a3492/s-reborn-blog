---
import '../styles/design.css';
import '../styles/global.css';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import LectureDraftBadge from '../components/LectureDraftBadge.astro';
import Topbar from '../components/Topbar.astro';
import PostStats from '../components/PostStats.astro';
import { publicTags } from '../data/tag-aliases';
import { relatedPosts } from '../lib/related-posts';
import BlogSidebar from '../components/BlogSidebar.astro';
import { buildCrumbs } from '../data/breadcrumbs';
import { localizeHref } from '../data/site-nav';
import { ACADEMY_COURSE, COURSE_LIST_HREF, countTopics } from '../data/taxonomy';

type Props = CollectionEntry<'blog'>['data'] & { postId?: string; lang?: 'ko' | 'en'; title_en?: string; description_en?: string };

const { title, title_en, description, description_en, date, updatedDate, thumbnail, tags, postId, lang = 'ko' } = Astro.props;
const lectureInProgress = Astro.props.category === 'doctor-ai' && Astro.props.needsExpansion;
const isEn = lang === 'en';
const displayTitle = isEn && title_en ? title_en : title;
const displayDescription = isEn && description_en ? description_en : description;
const articleSchema = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: displayTitle,
	description: displayDescription,
	url: new URL(Astro.url.pathname, Astro.site).href,
	mainEntityOfPage: { '@type': 'WebPage', '@id': new URL(Astro.url.pathname, Astro.site).href },
	datePublished: date.toISOString(),
	dateModified: updatedDate?.toISOString(),
	timeRequired: Astro.props.read_time ? `PT${Astro.props.read_time}M` : undefined,
};
const slug = Astro.url.pathname.replace(/^\/(?:en\/)?blog\//, '').replace(/\/$/, '');

const post = { id: postId ?? slug, data: Astro.props };
const navigation = buildCrumbs(Astro.url.pathname, Astro.url.hash, isEn, displayTitle, post);
const activeSection = navigation?.siblings.find(({ id }) => id === navigation.currentId);
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const counts = navigation?.sectionId === 'research' ? countTopics(allPosts) : undefined;
const displayTags = publicTags(tags);
const related = relatedPosts(allPosts, post.id);
const courseIndex = navigation?.currentId === 'lectures-course'
	? ACADEMY_COURSE.findIndex(({ ids }) => ids.some((id) => post.id === `doctor-ai/${id}`))
	: -1;
const part = ACADEMY_COURSE[courseIndex];
const coursePart = part && {
	label: isEn ? `Part ${courseIndex + 1} · ${part.labelEn}` : `${courseIndex + 1}부 · ${part.label}`,
	href: `${COURSE_LIST_HREF}#${part.id}`,
	lessons: part.ids.flatMap((id) => {
		const lessonId = `doctor-ai/${id}`;
		const lesson = allPosts.find((entry) => entry.id === lessonId);
		return lesson && lessonId !== post.id ? [{
			href: localizeHref(`/blog/${lessonId}/`, isEn),
			label: isEn ? (lesson.data.title_en ?? lesson.data.title) : lesson.data.title,
		}] : [];
	}),
};
---

<html lang={lang}>
	<head>
		<BaseHead title={displayTitle} description={displayDescription} image={thumbnail} noindex={lectureInProgress} />
		{updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
		<script type="application/ld+json" is:inline id="article-json-ld" set:html={JSON.stringify(articleSchema).replaceAll('<', '\\u003c')}></script>
	</head>

	<body class="blog-post-shell">
		<div class="site-wrap">
		<Topbar lang={lang} pageTitle={displayTitle} post={post} />
		<div class="site-main">
		<div class="blog-layout">

			{navigation && <BlogSidebar model={navigation} counts={counts} coursePart={coursePart} article isEn={isEn} />}

			<!-- ── 글 본문 ── -->
			<main class="blog-content blog-post-main">
				<article class="blog-post-article">
					{thumbnail && (
						<div class="blog-post-hero">
							<img src={thumbnail} alt={title} />
						</div>
					)}
					<div class="blog-post-prose prose">
						<div class="blog-post-title title">
							<div class="blog-post-meta meta">
								{activeSection && <span class="blog-post-category category-badge">{activeSection.label}</span>}
								{lectureInProgress && <LectureDraftBadge isEn={isEn} />}
								<FormattedDate date={date} />
								{updatedDate && <FormattedDate date={updatedDate} updated lang={lang} />}
							</div>
							<h1>{displayTitle}</h1>
							<PostStats slug={slug} />
							<hr />
						</div>
						{lectureInProgress ? (
							<p data-lecture-review-notice>{isEn
								? 'This lesson will be available after medical review. References are being prepared.'
								: '의학 내용은 원장님 검수 후 공개합니다. 참고문헌 정리 중입니다.'}</p>
						) : <slot />}

						{displayTags.length > 0 && (
							<div class="blog-post-tags blog-post-tags--after-body tags" aria-label="태그">
								{displayTags.map((tag) => <span class="blog-post-tag tag">#{tag}</span>)}
							</div>
						)}

						{related.length > 0 && (
							<aside class="blog-post-related" aria-labelledby="related-posts-title">
								<h2 id="related-posts-title">{isEn ? 'Related articles' : '연관 글'}</h2>
								<ul>{related.map((post) => (
									<li><a href={`${isEn ? '/en' : ''}/blog/${post.id}/`}>{isEn ? (post.data.title_en ?? post.data.title) : post.data.title}</a></li>
								))}</ul>
							</aside>
						)}

					</div>
				</article>
			</main>
		</div><!-- /.blog-layout -->
		</div><!-- /.site-main -->
		</div><!-- /.site-wrap -->
		<Footer />
	</body>
</html>

<style>
	.blog-post-main { min-width: 0; }
	.blog-post-meta { flex-wrap: wrap; }
	.blog-post-related { margin-block-start: 1.5rem; padding: 1rem; border-radius: .5rem; background: var(--site-subtle); }
	.blog-post-related h2 { font-size: 1rem; margin: 0; }
	.blog-post-related ul { margin-block-end: 0; }

	:global(.blog-post-prose .editorial-figure) {
		--figure-accent: var(--site-mint-text);
		margin: 1.5rem 0;
		padding: .65rem 0;
		border-block: 1px solid var(--site-border);
		color: var(--site-text);
		background: transparent;
	}
	:global(.editorial-figure svg) {
		display: block;
		width: 100%;
		max-width: 32rem;
		height: auto;
		font: inherit;
		font-size: 20px;
		fill: currentColor;
	}
	:global(.editorial-figure .editorial-rule),
	:global(.editorial-figure .editorial-ink) {
		stroke: currentColor;
		fill: none;
	}
	:global(.editorial-figure .editorial-rule) { opacity: .38; }
	:global(.editorial-figure .editorial-note),
	:global(.editorial-figure figcaption) { color: var(--site-text-secondary); }
	:global(.editorial-figure figcaption) {
		margin: .55rem 0 0;
		text-align: start;
		font-size: .875rem;
	}
	:global(.editorial-figure .editorial-accent) { color: var(--figure-accent); }
	:global(.editorial-figure text.editorial-note),
	:global(.editorial-figure text.editorial-accent) { fill: currentColor; }
	:global(.editorial-figure path.editorial-accent) { stroke: currentColor; stroke-width: 1.5; }
	:global(.editorial-comparison) {
		display: grid;
		grid-template-columns: max-content minmax(0, 1fr);
		gap: .35rem .8rem;
	}
	:global(.editorial-comparison span) { color: var(--site-text-secondary); font-weight: 700; }
	:global(.editorial-comparison em) { color: var(--figure-accent); font-style: normal; font-weight: 700; }

</style>
