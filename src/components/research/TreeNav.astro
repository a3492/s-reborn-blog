---
import { publicTree, type TreeNode } from '../../lib/research/tree';

interface Props {
	roots: TreeNode[];
	currentId: string;
}

const { roots, currentId } = Astro.props;

const rows: { node: TreeNode; depth: number }[] = [];
const walk = (nodes: TreeNode[], depth: number) => {
	for (const node of nodes) {
		rows.push({ node, depth });
		walk(node.children, depth + 1);
	}
};
walk(publicTree(roots), 0);
---

<nav class="research-tree" data-research-tree aria-label="연구 트리">
	<button class="research-tree-toggle" type="button" data-tree-toggle aria-expanded="false">트리 보기</button>
	<div class="research-tree-body">
		<h2>연구 트리</h2>
		<ul>
			{rows.map(({ node, depth }) => (
				<li class={`depth-${Math.min(depth, 4)}`}>
					<a href={node.path} aria-current={node.documentId === currentId ? 'page' : undefined}>{node.title}</a>
				</li>
			))}
		</ul>
	</div>
</nav>
