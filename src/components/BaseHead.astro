---
import { SITE_TITLE } from '../consts';
import { toEnglishPath, toKoreanPath } from '../data/site-nav';

interface Props {
	title: string;
	description: string;
	image?: string;
	siteTitle?: string;
	/** 미지정 시 URL로 추론: `/blog/분류/slug` 형태만 article, 나머지 website */
	ogType?: 'website' | 'article';
	noindex?: boolean;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image, siteTitle = SITE_TITLE, ogType: ogTypeProp, noindex = false } = Astro.props;

const pathNorm = Astro.url.pathname.replace(/\/$/, '') || '/';
const afterBlog = pathNorm.startsWith('/blog/') ? pathNorm.slice(6) : '';
const inferredOgType = afterBlog.includes('/') ? 'article' : 'website';
const ogType = ogTypeProp ?? inferredOgType;

// hreflang alternate URLs. English exists only for /blog/.
const isEnPath = pathNorm === '/en' || pathNorm.startsWith('/en/');
const koPath = isEnPath ? toKoreanPath(Astro.url.pathname) : Astro.url.pathname;
const enPath = isEnPath ? Astro.url.pathname : toEnglishPath(Astro.url.pathname);
const koCanonical = new URL(koPath, Astro.site);
const enCanonical = enPath ? new URL(enPath, Astro.site) : null;

const ogImage = image
	? (image.startsWith('http') ? image : new URL(image, Astro.url).href)
	: new URL('/blog-og-default.jpg', Astro.url).href;
---

<script is:inline>
(function(){
  const key='sreborn-theme';
  let mode='system';
  try { const saved=localStorage.getItem(key); if(saved==='light'||saved==='dark') mode=saved; } catch {}
  const dark=window.matchMedia('(prefers-color-scheme: dark)').matches;
  document.documentElement.dataset.theme=mode==='system'?(dark?'dark':'light'):mode;
  document.documentElement.dataset.themePreference=mode;
  document.documentElement.style.colorScheme=document.documentElement.dataset.theme;
})();
</script>
<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/manifest.json" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={siteTitle}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#d690a1" />
{noindex ? (
	<meta name="robots" content="noindex" />
) : pathNorm === '/admin' || pathNorm.startsWith('/admin/') ? (
	<meta name="robots" content="noindex, nofollow" />
) : null}

<!-- Font preloads -->
<link rel="preload" href="/fonts/atkinson-regular.woff" as="font" type="font/woff" crossorigin />
<link rel="preload" href="/fonts/atkinson-bold.woff" as="font" type="font/woff" crossorigin />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- hreflang alternates -->
<link rel="alternate" hreflang="ko" href={koCanonical} />
{enCanonical ? <link rel="alternate" hreflang="en" href={enCanonical} /> : null}
<link rel="alternate" hreflang="x-default" href={koCanonical} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content="ko_KR" />
<meta property="og:site_name" content={siteTitle} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImage} />
